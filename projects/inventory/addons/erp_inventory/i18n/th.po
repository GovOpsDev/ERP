#. module: erp_inventory
#. odoo-python
#: code:addons/erp_inventory/models/integration.py:0
msgid "A completed or cancelled transfer cannot change its work acceptance."
msgstr "การโอนที่เสร็จสิ้นหรือยกเลิกแล้วไม่สามารถเปลี่ยนรายการตรวจรับงาน"

#. module: erp_inventory
#. odoo-python
#: code:addons/erp_inventory/models/acceptance.py:0
