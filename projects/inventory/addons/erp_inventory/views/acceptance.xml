<odoo>
 <record id="acceptance_list" model="ir.ui.view"><field name="name">erp.inventory.acceptance.list</field><field name="model">erp.inventory.acceptance</field><field name="arch" type="xml"><list><field name="name"/><field name="purchase_order_id"/><field name="organization_id"/><field name="acceptance_date"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="acceptance_form" model="ir.ui.view"><field name="name">erp.inventory.acceptance.form</field><field name="model">erp.inventory.acceptance</field><field name="arch" type="xml"><form><header><button name="action_accept" type="object" string="ตรวจรับ" groups="erp_inventory.group_acceptance_manager" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="ยกเลิก" groups="erp_inventory.group_acceptance_manager" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" string="เลขที่ตรวจรับ"/><field name="company_id" string="บริษัท" groups="base.group_multi_company"/><field name="organization_id" string="หน่วยงาน"/><field name="purchase_order_id" string="ใบสั่งซื้อ"/><field name="partner_id" string="ผู้ขาย"/><field name="acceptance_date" string="วันที่ตรวจรับ"/></group><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="purchase_line_id" string="รายการสั่งซื้อ" domain="[('order_id', '=', parent.purchase_order_id)]"/><field name="product_id" string="สินค้า/บริการ"/><field name="quantity" string="จำนวนตรวจรับ"/><field name="uom_id" string="หน่วย"/></list></field><field name="notes" string="หมายเหตุ"/></sheet></form></field></record>
 <record id="acceptance_action" model="ir.actions.act_window"><field name="name">ตรวจรับงาน</field><field name="res_model">erp.inventory.acceptance</field><field name="view_mode">list,form</field></record>
 <menuitem id="acceptance_root" name="ตรวจรับงาน" groups="erp_inventory.group_acceptance_user" sequence="55"/><menuitem id="acceptance_menu" name="เอกสารตรวจรับ" parent="acceptance_root" action="acceptance_action"/>
</odoo>
