<odoo>
 <record id="product_negative_form" model="ir.ui.view"><field name="name">product.negative.stock</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/><field name="arch" type="xml"><xpath expr="//field[@name='categ_id']" position="after"><field name="erp_allow_negative_stock" groups="stock.group_stock_manager"/></xpath></field></record>
 <record id="category_negative_form" model="ir.ui.view"><field name="name">category.negative.stock</field><field name="model">product.category</field><field name="inherit_id" ref="product.product_category_form_view"/><field name="arch" type="xml"><xpath expr="//field[@name='parent_id']" position="after"><field name="erp_allow_negative_stock" groups="stock.group_stock_manager"/></xpath></field></record>
 <record id="location_negative_form" model="ir.ui.view"><field name="name">location.negative.stock</field><field name="model">stock.location</field><field name="inherit_id" ref="stock.view_location_form"/><field name="arch" type="xml"><xpath expr="//field[@name='usage']" position="after"><field name="erp_allow_negative_stock" groups="stock.group_stock_manager"/></xpath></field></record>
</odoo>
