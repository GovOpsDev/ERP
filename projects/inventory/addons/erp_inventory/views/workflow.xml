<odoo>
 <record id="acceptance_workflow_form" model="ir.ui.view"><field name="name">acceptance.workflow.form</field><field name="model">erp.inventory.acceptance</field><field name="inherit_id" ref="acceptance_form"/><field name="arch" type="xml">
  <xpath expr="//header" position="inside"><button name="action_create_invoice" type="object" string="Create Installment Bill" invisible="state != 'accept' or not installment_id" groups="erp_inventory.group_acceptance_manager"/><button name="action_request_review" type="object" string="Request Review" invisible="state != 'draft' or not paperless" groups="erp_inventory.group_acceptance_manager"/><button name="action_approve_review" type="object" string="Approve Review" invisible="state != 'draft' or not review_round" groups="erp_inventory.group_acceptance_manager"/><button name="action_reject_review" type="object" string="Reject Review" invisible="state != 'draft' or not review_round" groups="erp_inventory.group_acceptance_manager"/><button name="action_reset" type="object" string="Reset / Restart Reviews" groups="erp_inventory.group_acceptance_manager"/></xpath>
  <xpath expr="//button[@name='action_cancel']" position="attributes"><attribute name="invisible">state == 'cancel'</attribute></xpath>
  <xpath expr="//sheet" position="inside"><group><field name="paperless" readonly="state != 'draft' or review_round"/><field name="completeness" widget="progressbar"/><field name="review_round"/><field name="requested_acceptance_date" readonly="state != 'draft' or review_round" groups="erp_inventory.group_acceptance_manager"/><field name="responsible_id" readonly="state != 'draft' or review_round"/><field name="installment_id" readonly="state != 'draft' or review_round" domain="[('purchase_id', '=', purchase_order_id), ('invoice_type', '=', 'installment')]"/></group><notebook>
   <page string="Committees"><field name="committee_ids"><list editable="bottom"><field name="employee_id"/><field name="name"/><field name="approve_role"/><field name="status"/><field name="note"/></list></field></page>
   <page string="Supplier Evaluation"><field name="evaluation_ids"><list editable="bottom"><field name="case_id"/><field name="score_id" domain="[('evaluation_id','=',case_id)]"/><field name="note"/></list></field></page>
   <page string="Review History"><field name="review_ids" readonly="1"><list><field name="round_number"/><field name="sequence"/><field name="reviewer_id"/><field name="state"/><field name="decided_by_id"/><field name="decided_at"/></list></field></page>
  </notebook></xpath>
 </field></record>
 <record id="evaluation_form" model="ir.ui.view"><field name="name">supplier.evaluation.form</field><field name="model">erp.inventory.evaluation</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="state_required"/></group><field name="score_ids"><list editable="bottom"><field name="name"/><field name="score"/></list></field></sheet></form></field></record>
 <record id="evaluation_action" model="ir.actions.act_window"><field name="name">Supplier Evaluation Cases</field><field name="res_model">erp.inventory.evaluation</field><field name="view_mode">list,form</field></record>
 <menuitem id="evaluation_menu" name="Supplier Evaluation Cases" parent="acceptance_root" action="evaluation_action" groups="erp_inventory.group_acceptance_manager"/>
 <record id="picking_type_acceptance_form" model="ir.ui.view"><field name="name">picking.type.acceptance.form</field><field name="model">stock.picking.type</field><field name="inherit_id" ref="stock.view_picking_type_form"/><field name="arch" type="xml"><xpath expr="//field[@name='code']" position="after"><field name="erp_bypass_wa"/></xpath></field></record>
 <record id="purchase_acceptance_form" model="ir.ui.view"><field name="name">purchase.acceptance.form</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="erp_wa_paperless"/></xpath></field></record>
 <record id="purchase_plan_acceptance" model="ir.ui.view"><field name="name">purchase.plan.acceptance</field><field name="model">purchase.order</field><field name="inherit_id" ref="erp_procurement.view_purchase_invoice_plan"/><field name="arch" type="xml"><xpath expr="//field[@name='erp_invoice_plan_ids']/list" position="inside"><button name="action_create_acceptance" type="object" string="Create / Open Acceptance" groups="erp_inventory.group_acceptance_user"/></xpath></field></record>
</odoo>
