<odoo>
 <record id="acceptance_fines_form" model="ir.ui.view"><field name="name">acceptance.fines.form</field><field name="model">erp.inventory.acceptance</field><field name="inherit_id" ref="acceptance_form"/><field name="arch" type="xml">
  <xpath expr="//header" position="inside"><button name="action_create_vendor_fine" type="object" string="Create Fine Vendor Credit" invisible="state != 'accept' or fines_late &lt;= 0" groups="erp_inventory.group_acceptance_manager"/><button name="action_create_fines_invoice" type="object" string="Create Fine Invoice" invisible="state != 'accept' or fines_late &lt;= 0" groups="erp_inventory.group_acceptance_manager"/></xpath>
  <xpath expr="//sheet" position="inside"><group string="Late Delivery Fine"><field name="currency_id" invisible="1"/><field name="date_due"/><field name="date_receive"/><field name="late_days"/><field name="fines_rate"/><field name="fines_late"/><field name="fines_invoice_ids" readonly="1"/></group></xpath>
 </field></record>
 <record id="company_fines_form" model="ir.ui.view"><field name="name">company.acceptance.fines</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Work Acceptance Fines"><field name="erp_wa_fines_rate"/><field name="erp_wa_fines_account_id"/></group></xpath></field></record>
 <record id="move_fines_form" model="ir.ui.view"><field name="name">account.move.acceptance.fine</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='ref']" position="after"><field name="erp_late_acceptance_id" invisible="not erp_late_acceptance_id"/></xpath></field></record>
</odoo>
