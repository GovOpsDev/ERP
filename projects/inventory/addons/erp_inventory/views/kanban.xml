<odoo>
 <record id="card_form" model="ir.ui.view"><field name="name">stock.request.card.form</field><field name="model">erp.inventory.card</field><field name="arch" type="xml"><form><header><button name="action_request" type="object" string="Request Stock"/></header><sheet><group><field name="name"/><field name="barcode"/><field name="active"/><field name="company_id"/><field name="organization_id"/><field name="warehouse_id"/><field name="location_id"/><field name="product_id"/><field name="quantity"/><field name="uom_id"/><field name="route_id"/><field name="fund_id"/><field name="analytic_id"/></group></sheet></form></field></record>
 <record id="card_census_form" model="ir.ui.view"><field name="name">stock.card.census.form</field><field name="model">erp.inventory.card.census</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" invisible="state != 'draft'"/><button name="action_finish" type="object" string="Finish" invisible="state != 'in_progress'"/><button name="action_close" type="object" string="Close" invisible="state != 'finished'"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'closed'"/><button name="action_reset" type="object" string="Reset" invisible="state != 'cancelled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="organization_id"/><field name="warehouse_ids" widget="many2many_tags"/><field name="location_ids" widget="many2many_tags"/><field name="product_ids" widget="many2many_tags"/></group><notebook><page string="Expected Cards"><field name="card_ids"/></page><page string="Scanned Cards"><field name="scanned_ids"/></page><page string="Missing Cards"><field name="missing_ids"/></page></notebook></sheet></form></field></record>
 <record id="card_scan_form" model="ir.ui.view"><field name="name">stock.card.scan.form</field><field name="model">erp.inventory.card.scan</field><field name="arch" type="xml"><form><group><field name="census_id"/><field name="barcode"/></group><footer><button name="action_scan" type="object" string="Scan" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
 <record id="card_action" model="ir.actions.act_window"><field name="name">Kanban Cards</field><field name="res_model">erp.inventory.card</field><field name="view_mode">list,form</field></record>
 <record id="card_census_action" model="ir.actions.act_window"><field name="name">Kanban Card Inventory</field><field name="res_model">erp.inventory.card.census</field><field name="view_mode">list,form</field></record>
 <record id="card_scan_action" model="ir.actions.act_window"><field name="name">Scan Kanban Card</field><field name="res_model">erp.inventory.card.scan</field><field name="view_mode">form</field><field name="target">new</field></record>
 <menuitem id="card_menu" name="Kanban Cards" parent="stock_request_root" action="card_action"/><menuitem id="card_census_menu" name="Card Inventories" parent="stock_request_root" action="card_census_action"/><menuitem id="card_scan_menu" name="Scan Card" parent="stock_request_root" action="card_scan_action"/>
</odoo>
