    <record id="view_ledger_list" model="ir.ui.view">
        <field name="name">erp.budget.ledger.report.list</field>
        <field name="model">erp.budget.ledger.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="recorded_at" />
                <field name="document_key" />
                <field name="analytic_id" />
                <field name="period_id" />
                <field name="organization_id" />
                <field name="kpi_id" />
                <field name="category" />
                <field name="currency_id" column_invisible="True" />
                <field name="amount" sum="รวม" />
            </list>
        </field>
    </record>
    <record id="view_ledger_pivot" model="ir.ui.view">
        <field name="name">erp.budget.ledger.report.pivot</field>
