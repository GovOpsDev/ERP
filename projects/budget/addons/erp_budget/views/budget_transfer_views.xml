<odoo>
 <record id="budget_transfer_list" model="ir.ui.view">
  <field name="name">erp.budget.transfer.list</field><field name="model">erp.budget.transfer</field>
  <field name="arch" type="xml"><list><field name="name"/><field name="period_id"/><field name="organization_id"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field>
 </record>
 <record id="budget_transfer_form" model="ir.ui.view">
  <field name="name">erp.budget.transfer.form</field><field name="model">erp.budget.transfer</field>
  <field name="arch" type="xml"><form><header>
   <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" groups="erp_budget.group_budget_manager"/>
   <button name="action_submit_planning" type="object" string="Submit Planning" invisible="state != 'submit'" groups="erp_budget.group_budget_manager"/>
   <button name="action_approve" type="object" string="Approve Transfer" invisible="state != 'submit'" groups="erp_budget.group_budget_manager"/>
   <button name="action_reject" type="object" string="Reject" invisible="state != 'submit'" groups="erp_budget.group_budget_manager"/>
   <button name="action_transfer" type="object" string="Apply Transfer" invisible="state != 'submit'" groups="erp_budget.group_budget_manager"/>
   <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submit')" groups="erp_budget.group_budget_manager"/>
   <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'" groups="erp_budget.group_budget_manager"/>
   <button name="action_reverse" type="object" string="Prepare Reversal" invisible="state != 'done' or reversal_of_id" groups="erp_budget.group_budget_manager"/>
   <field name="state" widget="statusbar"/>
  </header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="allocation_id" readonly="state != 'draft'"/><field name="organization_id" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company"/><field name="period_id"/><field name="revision_id"/><field name="approval_id"/><field name="reversal_of_id"/><field name="transferred_by_id"/><field name="transferred_at"/></group>
   <field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="source_id"/><field name="source_control_id"/><field name="destination_id"/><field name="destination_control_id"/><field name="amount"/><field name="currency_id" column_invisible="1"/></list></field>
   <field name="planning_ids" readonly="1"><list create="0" delete="0"><field name="name"/><field name="plan_line_id"/><field name="released_amount"/><field name="state"/></list></field>
   <field name="review_ids" readonly="1"><list><field name="reviewer_id"/><field name="sequence"/><field name="state"/></list></field>
  </sheet></form></field>
 </record>
 <record id="budget_transfer_action" model="ir.actions.act_window"><field name="name">Budget Transfers</field><field name="res_model">erp.budget.transfer</field><field name="view_mode">list,form</field></record>
 <menuitem id="budget_transfer_menu" name="Budget Transfers" parent="erp_budget.menu_budget_root" action="budget_transfer_action" groups="erp_budget.group_budget_user"/>
</odoo>
