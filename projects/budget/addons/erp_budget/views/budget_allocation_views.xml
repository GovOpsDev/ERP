<odoo>
 <record id="budget_allocation_list" model="ir.ui.view"><field name="name">erp.budget.allocation.list</field><field name="model">erp.budget.allocation</field><field name="arch" type="xml"><list><field name="name"/><field name="period_id"/><field name="company_id"/><field name="state"/></list></field></record>
 <record id="budget_allocation_form" model="ir.ui.view"><field name="name">erp.budget.allocation.form</field><field name="model">erp.budget.allocation</field><field name="arch" type="xml"><form><header><button name="action_done" type="object" string="Done" invisible="state != 'draft'" groups="erp_budget.group_budget_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'done')" groups="erp_budget.group_budget_manager"/><button name="action_draft" type="object" string="Reset / Restore" invisible="state != 'cancel'" groups="erp_budget.group_budget_manager"/><button name="action_prepare_allocation_revision" type="object" string="Prepare Revision" invisible="state != 'done'" groups="erp_budget.group_budget_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="id"/><field name="period_id" readonly="id"/><field name="plan_id"/><field name="legacy_baseline"/><field name="captured_at"/><field name="captured_by_id"/></group><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="organization_id"/><field name="analytic_id"/><field name="fund_id"/><field name="dimension_ids" widget="many2many_tags"/><field name="introduced_revision_id"/><field name="allocated_amount"/><field name="released_amount"/><field name="control_id"/><field name="currency_id" column_invisible="1"/></list></field></sheet></form></field></record>
 <record id="budget_allocation_action" model="ir.actions.act_window"><field name="name">Fund Allocations</field><field name="res_model">erp.budget.allocation</field><field name="view_mode">list,form</field></record>
 <menuitem id="budget_allocation_menu" name="Fund Allocations" parent="erp_budget.menu_budget_root" action="budget_allocation_action" groups="erp_budget.group_budget_user"/>
</odoo>
