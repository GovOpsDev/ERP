<odoo>
 <record id="budget_balance_forward_list" model="ir.ui.view"><field name="name">erp.budget.balance.forward.list</field><field name="model">erp.budget.balance.forward</field><field name="arch" type="xml"><list><field name="name"/><field name="source_period_id"/><field name="destination_period_id"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="budget_balance_forward_form" model="ir.ui.view"><field name="name">erp.budget.balance.forward.form</field><field name="model">erp.budget.balance.forward</field><field name="arch" type="xml"><form><header>
  <button name="action_review" type="object" string="Review Balances" invisible="state != 'draft'" groups="erp_budget.group_budget_manager"/>
  <button name="action_forward" type="object" string="Forward" invisible="state != 'review'" groups="erp_budget.group_budget_manager"/>
  <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'" groups="erp_budget.group_budget_manager"/>
  <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'" groups="erp_budget.group_budget_manager"/>
  <button name="action_prepare_return_mapping" type="object" string="Prepare Return Distribution" invisible="state != 'done'" groups="erp_budget.group_budget_manager"/>
  <button name="action_prepare_return" type="object" string="Prepare Economic Return" invisible="state != 'done'" groups="erp_budget.group_budget_manager"/>
  <button name="action_submit_return_planning" type="object" string="Submit Return Planning" invisible="state != 'done' or not return_revision_id" groups="erp_budget.group_budget_manager"/>
  <button name="action_approve_return" type="object" string="Approve Return" invisible="state != 'done' or not return_revision_id" groups="erp_budget.group_budget_manager"/>
  <button name="action_cancel_return" type="object" string="Cancel Return Proposal" invisible="state != 'done' or not return_revision_id" groups="erp_budget.group_budget_manager"/>
  <button name="action_apply_return" type="object" string="Apply Economic Return" invisible="state != 'done' or not return_revision_id" groups="erp_budget.group_budget_manager"/>
  <field name="state" widget="statusbar"/>
 </header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="1"/><field name="source_period_id" readonly="state != 'draft'"/><field name="destination_period_id" readonly="state != 'draft'"/><field name="review_round"/><field name="forwarded_by_id"/><field name="forwarded_at"/><field name="return_revision_id"/><field name="return_approval_id"/><field name="return_editable" invisible="1"/></group>
  <field name="line_ids" readonly="state != 'review'"><list editable="bottom" create="0" delete="0"><field name="round_number"/><field name="source_line_id"/><field name="organization_id"/><field name="balance_amount"/><field name="destination_analytic_id"/><field name="forward_amount"/><field name="accumulate_analytic_id"/><field name="reserved"/><field name="opening_ids" widget="many2many_tags"/><field name="currency_id" column_invisible="1"/></list></field>
  <field name="return_mapping_ids" readonly="not return_editable"><list editable="bottom"><field name="opening_id"/><field name="analytic_control_id"/><field name="fund_control_id"/><field name="amount"/><field name="currency_id" column_invisible="1"/></list></field>
  <field name="return_planning_ids" readonly="1"><list create="0" delete="0"><field name="plan_line_id"/><field name="released_amount"/><field name="state"/></list></field>
 </sheet></form></field></record>
 <record id="budget_balance_forward_action" model="ir.actions.act_window"><field name="name">Budget Balance Forward</field><field name="res_model">erp.budget.balance.forward</field><field name="view_mode">list,form</field></record>
 <menuitem id="budget_balance_forward_menu" name="Balance Forward" parent="erp_budget.menu_budget_root" action="budget_balance_forward_action" groups="erp_budget.group_budget_user"/>
</odoo>
