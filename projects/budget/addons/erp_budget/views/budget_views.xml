<odoo>
    <record id="view_period_list" model="ir.ui.view"><field name="name">erp.budget.period.list</field><field name="model">erp.budget.period</field><field name="arch" type="xml"><list><field name="name"/><field name="date_from"/><field name="date_to"/><field name="template_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
