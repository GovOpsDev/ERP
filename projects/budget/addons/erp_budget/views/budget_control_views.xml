<odoo>
    <record id="view_budget_control_list" model="ir.ui.view"><field name="name">erp.budget.control.list</field><field name="model">erp.budget.control</field><field name="arch" type="xml"><list><field name="name"/><field name="period_id"/><field name="organization_id"/><field name="level"/><field name="amount"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_budget_control_form" model="ir.ui.view"><field name="name">erp.budget.control.form</field><field name="model">erp.budget.control</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Open" invisible="state != 'draft'" groups="erp_budget.group_budget_manager"/><button name="action_close" type="object" string="Close" invisible="state != 'open'" groups="erp_budget.group_budget_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="period_id" readonly="state != 'draft'"/><field name="organization_id" readonly="state != 'draft'"/><field name="analytic_id" readonly="state != 'draft'"/><field name="level" readonly="state != 'draft'"/><field name="kpi_id" invisible="level != 'analytic'" readonly="state != 'draft'"/><field name="fund_id" invisible="level != 'fund'" readonly="state != 'draft'"/><field name="dimension_ids" widget="many2many_tags" invisible="level != 'fund'" readonly="state != 'draft'"/><field name="amount" readonly="state != 'draft'"/><field name="available_amount"/><field name="active" readonly="state != 'draft'"/></group><field name="move_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="origin_key"/><field name="move_type"/><field name="amount"/><field name="reversal_of_id"/></list></field></sheet></form></field></record>
    <record id="action_budget_control" model="ir.actions.act_window"><field name="name">Budget Allocations</field><field name="res_model">erp.budget.control</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_budget_control" name="Allocations" parent="erp_budget.menu_budget_root" action="action_budget_control"/>
</odoo>
