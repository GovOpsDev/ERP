<odoo>
    <record id="adjustment_sequence" model="ir.sequence"><field name="name">Budget Adjustment</field><field name="code">erp.budget.adjustment</field><field name="prefix">BADJ/</field><field name="padding">5</field></record>
    <record id="adjustment_list" model="ir.ui.view"><field name="name">erp.budget.adjustment.list</field><field name="model">erp.budget.adjustment</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="description"/><field name="organization_id"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="adjustment_form" model="ir.ui.view"><field name="name">erp.budget.adjustment.form</field><field name="model">erp.budget.adjustment</field><field name="arch" type="xml"><form><header><button name="action_adjust" type="object" string="Apply Adjustment" groups="erp_budget.group_budget_manager" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" groups="erp_budget.group_budget_manager" invisible="state == 'cancel'"/><button name="action_draft" type="object" string="Reset to Draft" groups="erp_budget.group_budget_manager" invisible="state != 'cancel'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company" readonly="id"/><field name="organization_id" readonly="id"/><field name="date" readonly="state != 'draft' or confirmed_at"/><field name="description" readonly="state != 'draft' or confirmed_at"/><field name="confirmed_by_id"/><field name="confirmed_at"/></group><field name="line_ids" readonly="state != 'draft' or confirmed_at"><list editable="bottom"><field name="name"/><field name="direction"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="period_id"/><field name="fund_id"/><field name="analytic_id"/><field name="activity_id"/><field name="account_id"/><field name="dimension_ids" widget="many2many_tags"/></list></field></sheet></form></field></record>
    <record id="adjustment_action" model="ir.actions.act_window"><field name="name">Budget Actual Adjustments</field><field name="res_model">erp.budget.adjustment</field><field name="view_mode">list,form</field></record>
    <menuitem id="adjustment_menu" name="Actual Adjustments" parent="menu_budget_root" action="adjustment_action" groups="erp_budget.group_budget_user"/>
</odoo>
