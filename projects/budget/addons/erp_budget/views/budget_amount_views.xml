<odoo>
    <record id="budget_amount_settings" model="ir.ui.view">
        <field name="name">res.config.settings.budget.amount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Budget" name="erp_budget" groups="base.group_system">
                    <block title="Document Amounts" name="budget_amounts">
                        <setting string="Budget amount policy" company_dependent="1" help="Choose the taxes included in new commitments and actual expenditure. Confirmed document amounts retain their approval rate and policy.">
                            <field name="erp_budget_amount_mode"/>
                        </setting>
                        <setting string="Purchase taxes" company_dependent="1" invisible="erp_budget_amount_mode != 'specific'">
                            <field name="erp_budget_purchase_tax_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
                        </setting>
                        <setting string="Accounting taxes" company_dependent="1" invisible="erp_budget_amount_mode != 'specific'">
                            <field name="erp_budget_account_tax_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
                        </setting>
                        <setting string="Expense taxes" company_dependent="1" invisible="erp_budget_amount_mode != 'specific'">
                            <field name="erp_budget_expense_tax_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="budget_settings_action" model="ir.actions.act_window">
        <field name="name">Budget Settings</field><field name="res_model">res.config.settings</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'module': 'erp_budget'}</field>
    </record>
    <menuitem id="budget_settings_menu" name="Settings" parent="menu_budget_root" action="budget_settings_action" groups="base.group_system" sequence="100"/>
</odoo>
