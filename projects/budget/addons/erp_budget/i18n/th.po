#. module: erp_budget
#: model:ir.model.constraint,message:erp_budget.constraint_erp_budget_kpi_release_line_control_unique
msgid "A KPI control occurs once per release version."
msgstr "รายการควบคุมตัวชี้วัดมีได้หนึ่งรายการต่อฉบับปล่อยงบ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_planning_revision.py:0
msgid "A KPI revision cannot remove consumed capacity."
msgstr "การปรับปรุงตัวชี้วัดไม่สามารถตัดวงเงินที่ใช้ไปแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A PR identity and positive amount are required."
msgstr "ต้องระบุใบขอซื้อและจำนวนเงินมากกว่าศูนย์"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A budget allocation must begin in draft."
msgstr "การจัดสรรงบประมาณต้องเริ่มจากสถานะร่าง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A budget control reference no longer belongs to its company."
msgstr "รายการควบคุมงบประมาณที่อ้างอิงไม่ได้อยู่ในบริษัทของรายการแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A budget date is required."
msgstr "ต้องระบุวันที่งบประมาณ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A budget manager and positive amount are required."
msgstr "ต้องมีผู้จัดการงบประมาณและจำนวนเงินมากกว่าศูนย์"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A cancelled allocation must be restored through its revision workflow."
msgstr "ต้องกู้คืนการจัดสรรที่ยกเลิกผ่านขั้นตอนปรับปรุงการจัดสรร"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
msgid "A completed allocation and confirmed plan are required."
msgstr "ต้องมีการจัดสรรที่เสร็จสิ้นและแผนที่ยืนยันแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_transfer.py:0
msgid "A completed allocation and transfer items are required."
msgstr "ต้องมีการจัดสรรที่เสร็จสิ้นและรายการโอน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A destination plan line is required."
msgstr "ต้องระบุรายการแผนปลายทาง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_adjustment.py:0
msgid "A draft adjustment with a reason and lines is required."
msgstr "ต้องมีรายการปรับปรุงสถานะร่างพร้อมเหตุผลและรายการย่อย"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A draft release and control are required."
msgstr "ต้องมีรายการปล่อยงบสถานะร่างและรายการควบคุม"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A draft release for a confirmed formal-allocation plan is required."
msgstr "ต้องมีรายการปล่อยงบสถานะร่างสำหรับแผนจัดสรรอย่างเป็นทางการที่ยืนยันแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A draft release with KPI controls is required."
msgstr "ต้องมีรายการปล่อยงบสถานะร่างที่มีรายการควบคุมตัวชี้วัด"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
#: code:addons/erp_budget/models/budget_revision.py:0
msgid "A draft revision with a reason is required."
msgstr "ต้องมีฉบับปรับปรุงสถานะร่างพร้อมเหตุผล"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_transfer.py:0
msgid "A draft transfer approval cannot authorize capacity."
msgstr "การอนุมัติโอนสถานะร่างไม่สามารถอนุญาตวงเงิน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_master.py:0
msgid "A fund group with funds cannot change company."
msgstr "กลุ่มแหล่งเงินที่มีแหล่งเงินอยู่แล้วไม่สามารถเปลี่ยนบริษัท"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_amount.py:0
msgid "A manual rate must be positive, or zero for the native rate."
msgstr "อัตราที่ระบุเองต้องมากกว่าศูนย์ หรือเป็นศูนย์เพื่อใช้อัตราของระบบ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_revision.py:0
msgid "A missing effective version requires repair."
msgstr "ต้องแก้ไขฉบับที่มีผลซึ่งขาดหายไป"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
msgid "A new dimension needs a positive amount in company currency precision."
msgstr "มิติใหม่ต้องมีจำนวนเงินมากกว่าศูนย์ตามความละเอียดของสกุลเงินบริษัท"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
msgid "A new dimension requires positive capacity."
msgstr "มิติใหม่ต้องมีวงเงินมากกว่าศูนย์"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation.py:0
msgid "A nonempty draft allocation in the period company is required."
msgstr "ต้องมีการจัดสรรสถานะร่างที่มีรายการในบริษัทของงวด"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A nonempty draft plan is required."
msgstr "ต้องมีแผนสถานะร่างที่มีรายการ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A period with a confirmed plan cannot be reconfigured."
msgstr "ไม่สามารถเปลี่ยนการกำหนดค่าของงวดที่มีแผนยืนยันแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A plan line is required."
msgstr "ต้องระบุรายการแผน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A plan must begin in draft."
msgstr "แผนต้องเริ่มจากสถานะร่าง"

#. module: erp_budget
#: model:ir.model.constraint,message:erp_budget.constraint_erp_budget_plan_event_reversal_unique
msgid "A plan transfer may only be reversed once."
msgstr "การโอนแผนกลับรายการได้เพียงครั้งเดียว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_plan.py:0
msgid "A plan with lines cannot change company or period."
msgstr "แผนที่มีรายการแล้วไม่สามารถเปลี่ยนบริษัทหรืองวด"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A positive amount and exactly one control for each level are required."
msgstr "ต้องระบุจำนวนเงินมากกว่าศูนย์และรายการควบคุมหนึ่งรายการต่อระดับ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_amount.py:0
msgid "A positive finite company-currency exchange rate is required."
msgstr "ต้องระบุอัตราแลกเปลี่ยนสกุลเงินบริษัทที่เป็นจำนวนจำกัดและมากกว่าศูนย์"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_commit_forward.py:0
msgid "A primary request must have one agreed fallback destination per fiscal period."
msgstr "คำขอหลักต้องมีปลายทางสำรองที่ตกลงกันหนึ่งแห่งต่องวดงบประมาณ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A referenced budget control no longer exists."
msgstr "ไม่พบรายการควบคุมงบประมาณที่อ้างอิง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A release must begin in draft with derived scope."
msgstr "การปล่อยงบต้องเริ่มจากสถานะร่างโดยใช้ขอบเขตที่คำนวณจากต้นทาง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "A release with active consumption cannot be reversed."
msgstr "ไม่สามารถกลับรายการปล่อยงบที่มีการใช้วงเงินอยู่"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_balance_return.py:0
msgid "A return distribution requires a positive precise amount."
msgstr "การกระจายยอดคืนต้องใช้จำนวนเงินที่มีความละเอียดถูกต้องและมากกว่าศูนย์"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A reversed commitment cannot be reused."
msgstr "ไม่สามารถนำภาระผูกพันที่กลับรายการแล้วมาใช้ซ้ำ"

#. module: erp_budget
#: model:ir.model.constraint,message:erp_budget.constraint_erp_budget_kpi_tier_tier_reviewer_unique
msgid "A reviewer may have only one tier per company and organization."
msgstr "ผู้ตรวจทานมีได้เพียงหนึ่งลำดับต่อบริษัทและหน่วยงาน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_revision.py:0
msgid "A revision cannot reduce a ceiling below allocations."
msgstr "การปรับปรุงไม่สามารถลดวงเงินต่ำกว่ายอดจัดสรร"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_revision.py:0
msgid "A revision cannot reduce a ceiling below consumption."
msgstr "การปรับปรุงไม่สามารถลดวงเงินต่ำกว่ายอดที่ใช้แล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A stable origin key is required."
msgstr "ต้องระบุรหัสต้นทางที่คงที่"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_transfer.py:0
msgid "A transfer cannot remove consumed capacity."
msgstr "การโอนไม่สามารถตัดวงเงินที่ใช้ไปแล้ว"

#. module: erp_budget
#: model:ir.model.constraint,message:erp_budget.constraint_erp_budget_transfer_reversal_unique
msgid "A transfer has one reversal document."
msgstr "การโอนมีเอกสารกลับรายการได้หนึ่งฉบับ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "A used activity account cannot change; create a new activity."
msgstr "ไม่สามารถเปลี่ยนบัญชีของกิจกรรมที่ใช้งานแล้ว โปรดสร้างกิจกรรมใหม่"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "A valid commitment and both controls are required."
msgstr "ต้องมีภาระผูกพันที่ถูกต้องและรายการควบคุมทั้งสองรายการ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_release.py:0
msgid "Access to all release lines is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการปล่อยงบ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation.py:0
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
msgid "Access to every allocation line is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการจัดสรร"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_legacy.py:0
msgid "Access to every plan line is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการแผน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_allocation_revision.py:0
msgid "Access to every revision line is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการปรับปรุง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_balance_forward.py:0
msgid "Access to every source plan line is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการแผนต้นทาง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_transfer.py:0
msgid "Access to every transfer item is required."
msgstr "ต้องมีสิทธิ์เข้าถึงทุกรายการโอน"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_activity__account_id
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_adjustment_line__account_id
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_template_line__account_id
msgid "Account"
msgstr "บัญชี"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_control.py:0
msgid "Account company does not match budget company."
msgstr "บริษัทของบัญชีไม่ตรงกับบริษัทของงบประมาณ"

#. module: erp_budget
#: model_terms:ir.ui.view,arch_db:erp_budget.budget_amount_settings
msgid "Accounting taxes"
msgstr "ภาษีทางบัญชี"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_balance_forward_line__accumulate_analytic_id
msgid "Accumulate Analytic"
msgstr "สะสมตามบัญชีวิเคราะห์"

#. module: erp_budget
#: model_terms:ir.ui.view,arch_db:erp_budget.budget_allocation_revision_form
#: model_terms:ir.ui.view,arch_db:erp_budget.budget_plan_version_form
msgid "Activate"
msgstr "เปิดใช้งาน"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_revision.py:0
msgid "Activate this plan through its allocation revision."
msgstr "ให้เปิดใช้แผนนี้ผ่านการปรับปรุงการจัดสรรที่เกี่ยวข้อง"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_commit_return.py:0
msgid "Activate this successor through its reviewed commitment return."
msgstr "ให้เปิดใช้รายการสืบทอดนี้ผ่านการคืนภาระผูกพันที่ตรวจทานแล้ว"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_transfer.py:0
msgid "Activate transfer successors through the approved transfer document."
msgstr "ให้เปิดใช้รายการสืบทอดการโอนผ่านเอกสารโอนที่อนุมัติแล้ว"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_allocation_revision__activated_by_id
msgid "Activated By"
msgstr "ผู้เปิดใช้งาน"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_activity__active
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_control__active
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_fund__active
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_fund_group__active
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_kpi__active
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_kpi_tier__active
msgid "Active"
msgstr "ใช้งาน"

#. module: erp_budget
#: model:ir.ui.menu,name:erp_budget.budget_activity_menu
msgid "Activities"
msgstr "กิจกรรม"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_adjustment_line__activity_id
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_template_activity__activity_id
msgid "Activity"
msgstr "กิจกรรม"

#. module: erp_budget
#: model:ir.model.fields,field_description:erp_budget.field_erp_budget_template__activity_line_ids
msgid "Activity Line"
msgstr "รายการกิจกรรม"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity account and KPI must belong to the activity company."
msgstr "บัญชีกิจกรรมและตัวชี้วัดต้องอยู่ในบริษัทของกิจกรรม"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity company is immutable."
msgstr "ไม่สามารถเปลี่ยนบริษัทของกิจกรรม"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity locking is internal."
msgstr "การล็อกกิจกรรมเป็นการทำงานภายในระบบ"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity mapping ownership is immutable."
msgstr "ไม่สามารถเปลี่ยนเจ้าของการจับคู่กิจกรรม"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity mappings require active activity and KPI in the template company."
msgstr "การจับคู่กิจกรรมต้องมีกิจกรรมและตัวชี้วัดที่ใช้งานอยู่ในบริษัทของแม่แบบ"

#. module: erp_budget
#: model:ir.model.constraint,message:erp_budget.constraint_erp_budget_activity_name_company_unique
msgid "Activity names must be unique in their company."
msgstr "ชื่อกิจกรรมต้องไม่ซ้ำกันภายในบริษัท"

#. module: erp_budget
#. odoo-python
#: code:addons/erp_budget/models/budget_activity.py:0
msgid "Activity, budget account and template company must match."
msgstr "บริษัทของกิจกรรม บัญชีงบประมาณ และแม่แบบต้องตรงกัน"

#. module: erp_budget
#: model:ir.ui.menu,name:erp_budget.adjustment_menu
msgid "Actual Adjustments"
msgstr "การปรับปรุงค่าใช้จ่ายจริง"

#. module: erp_budget
#: model:ir.model.fields.selection,name:erp_budget.selection__erp_budget_move__move_type__actual
msgid "Actual Expenditure"
msgstr "ค่าใช้จ่ายจริง"

#. module: erp_budget
#: model:ir.model.fields.selection,name:erp_budget.selection__erp_budget_move__move_type__actual_reversal
msgid "Actual Reversal"
msgstr "การกลับรายการค่าใช้จ่ายจริง"

#. module: erp_budget
#. odoo-python
