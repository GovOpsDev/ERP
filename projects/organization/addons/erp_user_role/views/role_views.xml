<odoo>
  <record id="role_list" model="ir.ui.view"><field name="name">erp.user.role.list</field><field name="model">erp.user.role</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="company_id"/><field name="active"/></list></field></record>
  <record id="role_form" model="ir.ui.view"><field name="name">erp.user.role.form</field><field name="model">erp.user.role</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="active"/><field name="group_ids" widget="many2many_tags"/><field name="description"/><field name="is_readonly_user" groups="base.group_system"/><field name="unrestrict_model_update" groups="base.group_system"/></group></sheet></form></field></record>
  <record id="assignment_list" model="ir.ui.view"><field name="name">erp.user.role.assignment.list</field><field name="model">erp.user.role.assignment</field><field name="arch" type="xml"><list><field name="user_id"/><field name="role_id"/><field name="company_id"/><field name="unit_id"/><field name="date_from"/><field name="date_to"/><field name="active"/><field name="effective"/></list></field></record>
  <record id="assignment_form" model="ir.ui.view"><field name="name">erp.user.role.assignment.form</field><field name="model">erp.user.role.assignment</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="user_id" domain="[('company_ids', 'in', [company_id])]"/><field name="role_id" domain="[('company_id', '=', company_id)]"/><field name="unit_id" domain="[('company_id', '=', company_id)]"/><field name="date_from"/><field name="date_to"/><field name="active"/><field name="effective"/></group></sheet></form></field></record>
  <record id="delegation_list" model="ir.ui.view"><field name="name">erp.user.role.delegation.list</field><field name="model">erp.user.role.delegation</field><field name="arch" type="xml"><list><field name="manager_id"/><field name="role_id"/><field name="company_id"/><field name="unit_id"/></list></field></record>
  <record id="delegation_form" model="ir.ui.view"><field name="name">erp.user.role.delegation.form</field><field name="model">erp.user.role.delegation</field><field name="arch" type="xml"><form><sheet><group><field name="manager_id"/><field name="role_id"/><field name="company_id"/><field name="unit_id" domain="[('company_id', '=', company_id)]"/></group></sheet></form></field></record>
  <record id="mapping_delegation_list" model="ir.ui.view"><field name="name">erp.user.role.mapping.delegation.list</field><field name="model">erp.user.role.mapping.delegation</field><field name="arch" type="xml"><list><field name="manager_id"/><field name="role_id"/><field name="company_id"/><field name="group_ids" widget="many2many_tags"/></list></field></record>
  <record id="mapping_delegation_form" model="ir.ui.view"><field name="name">erp.user.role.mapping.delegation.form</field><field name="model">erp.user.role.mapping.delegation</field><field name="arch" type="xml"><form><sheet><group><field name="manager_id"/><field name="role_id"/><field name="company_id"/><field name="group_ids" widget="many2many_tags"/></group></sheet></form></field></record>
  <record id="action_role" model="ir.actions.act_window"><field name="name">Roles</field><field name="res_model">erp.user.role</field><field name="view_mode">list,form</field></record>
  <record id="action_assignment" model="ir.actions.act_window"><field name="name">Role Assignments</field><field name="res_model">erp.user.role.assignment</field><field name="view_mode">list,form</field></record>
  <record id="action_delegation" model="ir.actions.act_window"><field name="name">Role Delegations</field><field name="res_model">erp.user.role.delegation</field><field name="view_mode">list,form</field></record>
  <record id="action_mapping_delegation" model="ir.actions.act_window"><field name="name">Role Definition Delegations</field><field name="res_model">erp.user.role.mapping.delegation</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_roles" name="Roles" parent="erp_organization.menu_organization_root" action="action_role" groups="erp_user_role.group_role_manager,base.group_system"/>
  <menuitem id="menu_role_assignments" name="Role Assignments" parent="erp_organization.menu_organization_root" action="action_assignment" groups="erp_user_role.group_role_manager,base.group_system"/>
  <menuitem id="menu_role_delegation" name="Role Delegations" parent="erp_organization.menu_organization_root" action="action_delegation" groups="base.group_system"/>
  <menuitem id="menu_role_mapping_delegation" name="Role Definition Delegations" parent="erp_organization.menu_organization_root" action="action_mapping_delegation" groups="base.group_system"/>
</odoo>
