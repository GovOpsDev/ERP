<odoo>
    <record id="view_organization_assignment_list" model="ir.ui.view">
        <field name="name">erp.organization.assignment.list</field>
        <field name="model">erp.organization.assignment</field>
        <field name="arch" type="xml">
            <list><field name="user_id"/><field name="unit_id"/><field name="company_id" groups="base.group_multi_company"/><field name="is_default"/></list>
        </field>
    </record>
    <record id="view_organization_assignment_form" model="ir.ui.view">
        <field name="name">erp.organization.assignment.form</field>
        <field name="model">erp.organization.assignment</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="user_id"/><field name="unit_id"/><field name="company_id" groups="base.group_multi_company"/><field name="is_default"/></group></sheet></form>
        </field>
    </record>
    <record id="action_organization_assignment" model="ir.actions.act_window">
        <field name="name">Organization Assignments</field>
        <field name="res_model">erp.organization.assignment</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_organization_assignment" name="Organization Assignments" parent="menu_organization_root" action="action_organization_assignment"/>
</odoo>
