<odoo>
    <record id="recurrence_change_form" model="ir.ui.view"><field name="name">erp.contract.recurrence.change.form</field><field name="model">erp.contract.recurrence.change</field><field name="arch" type="xml"><form><group><field name="contract_id"/><field name="line_id" domain="[('contract_id', '=', contract_id)]" invisible="operation == 'terminate'"/><field name="operation"/><field name="start_date" invisible="operation != 'amend'"/><field name="end_date"/><field name="quantity" invisible="operation != 'amend'"/><field name="price_unit" invisible="operation != 'amend'"/><field name="reason" invisible="operation != 'terminate'"/></group><footer><button name="action_apply" type="object" string="Apply Schedule Change" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="recurrence_change_action" model="ir.actions.act_window"><field name="name">Change Contract Schedule</field><field name="res_model">erp.contract.recurrence.change</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="contract_recurrence_form" model="ir.ui.view"><field name="name">erp.contract.recurrence.form</field><field name="model">erp.contract.contract</field><field name="inherit_id" ref="contract_form"/><field name="arch" type="xml">
        <xpath expr="//header" position="inside"><button name="action_generate_recurring" type="object" string="Generate Next Recurring Bills" invisible="not recurrence_enabled or termination_date" groups="erp_contract.group_contract_manager"/><button name="%(recurrence_change_action)d" type="action" string="Change Schedule" context="{'default_contract_id': id}" invisible="not recurrence_enabled" groups="erp_contract.group_contract_manager"/><button name="action_cancel_termination" type="object" string="Cancel Termination" invisible="not termination_date" groups="erp_contract.group_contract_manager"/></xpath>
        <xpath expr="//field[@name='commit_budget']" position="after"><field name="recurrence_enabled"/><field name="termination_date"/><field name="termination_reason"/></xpath>
        <xpath expr="//field[@name='line_ids']/list" position="attributes"><attribute name="open_form_view">1</attribute></xpath>
        <xpath expr="//field[@name='line_ids']/list/field[@name='date_end']" position="after"><field name="recurring_next_date" optional="hide"/><field name="recurrence_stop_date" optional="hide"/><field name="recurrence_canceled" optional="hide"/><field name="predecessor_id" optional="hide"/></xpath>
        <xpath expr="//sheet" position="inside"><group string="Recurring Period History" invisible="not recurrence_enabled"><field name="cycle_ids" nolabel="1"><list create="0" edit="0" delete="0"><field name="line_id"/><field name="date_from"/><field name="date_to"/><field name="invoice_date"/><field name="invoice_ids" widget="many2many_tags"/><button name="action_create_invoice" type="object" string="Open / Regenerate Bill"/></list></field></group></xpath>
    </field></record>
    <record id="recurring_line_form" model="ir.ui.view"><field name="name">erp.contract.line.recurrence.form</field><field name="model">erp.contract.line</field><field name="arch" type="xml"><form><header><button name="%(recurrence_change_action)d" type="action" string="Change Schedule" context="{'default_contract_id': contract_id, 'default_line_id': id, 'default_quantity': quantity, 'default_price_unit': price_unit, 'default_end_date': date_end}" groups="erp_contract.group_contract_manager"/><button name="action_cancel_recurrence" type="object" string="Cancel Unused Schedule" invisible="recurrence_canceled" groups="erp_contract.group_contract_manager"/><button name="action_reset_recurrence" type="object" string="Reset Schedule" invisible="not recurrence_canceled" groups="erp_contract.group_contract_manager"/></header><sheet><group><field name="contract_id"/><field name="name"/><field name="product_id"/><field name="uom_id"/><field name="quantity"/><field name="price_unit"/><field name="currency_id" invisible="1"/><field name="date_start"/><field name="date_end"/><field name="period_id"/><field name="fund_id"/><field name="analytic_id"/><field name="activity_id"/><field name="account_id"/><field name="dimension_ids" widget="many2many_tags"/></group><group string="Recurring Billing"><field name="recurring_rule_type"/><field name="recurring_interval"/><field name="recurring_invoicing_type"/><field name="recurring_next_date"/><field name="next_period_start"/><field name="next_period_end"/><field name="recurrence_stop_date"/><field name="recurrence_canceled"/></group><group string="Renewal"><field name="auto_renew"/><field name="auto_renew_rule_type"/><field name="auto_renew_interval"/><field name="termination_notice_days"/><field name="predecessor_id"/><field name="successor_ids" widget="many2many_tags"/></group></sheet></form></field></record>
    <record id="cron_recurring_bills" model="ir.cron"><field name="name">Contract recurring draft bills</field><field name="model_id" ref="model_erp_contract_contract"/><field name="state">code</field><field name="code">model._cron_recurring_invoices()</field><field name="interval_number">1</field><field name="interval_type">days</field></record>
    <record id="cron_contract_renewal" model="ir.cron"><field name="name">Contract renewal successors</field><field name="model_id" ref="model_erp_contract_line"/><field name="state">code</field><field name="code">model._cron_renew_contract_lines()</field><field name="interval_number">1</field><field name="interval_type">days</field></record>
</odoo>
