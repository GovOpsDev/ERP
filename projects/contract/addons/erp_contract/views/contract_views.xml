<odoo>
    <record id="contract_list" model="ir.ui.view"><field name="name">erp.contract.contract.list</field><field name="model">erp.contract.contract</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="organization_id"/><field name="journal_id"/><field name="commit_budget"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="contract_form" model="ir.ui.view"><field name="name">erp.contract.contract.form</field><field name="model">erp.contract.contract</field><field name="arch" type="xml"><form><header><button name="action_commit_budget" type="object" string="Commit Budget" groups="erp_contract.group_contract_manager" invisible="commit_budget"/><button name="action_close_budget" type="object" string="Close Budget" groups="erp_contract.group_contract_manager" invisible="not commit_budget"/><button name="action_archive_contract" type="object" string="Archive" groups="erp_contract.group_contract_manager" invisible="not active"/></header><sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="organization_id"/><field name="partner_id"/><field name="journal_id"/><field name="currency_id"/><field name="erp_budget_manual_rate" groups="erp_budget.group_budget_manager,account.group_account_manager" readonly="commit_budget"/><field name="active"/><field name="commit_budget"/></group><field name="line_ids" readonly="commit_budget or not active"><list editable="bottom"><field name="name"/><field name="product_id"/><field name="uom_id"/><field name="quantity"/><field name="price_unit"/><field name="erp_budget_fx_rate" optional="hide"/><field name="erp_budget_unit_company" string="Budget Unit Cost (Company Currency)" optional="hide"/><field name="currency_id" column_invisible="True"/><field name="date_start"/><field name="date_end"/><field name="period_id"/><field name="fund_id"/><field name="analytic_id"/><field name="activity_id"/><field name="account_id"/><field name="dimension_ids" widget="many2many_tags"/></list></field></sheet></form></field></record>
    <record id="contract_action" model="ir.actions.act_window"><field name="name">Purchase Contracts</field><field name="res_model">erp.contract.contract</field><field name="view_mode">list,form</field></record>
    <menuitem id="contract_menu" name="Contracts" parent="agreement_root" action="contract_action"/>
    <record id="account_move_form" model="ir.ui.view"><field name="name">account.move.contract.form</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after"><field name="erp_contract_line_id" optional="hide" groups="erp_contract.group_contract_user,account.group_account_invoice"/></xpath></field></record>
</odoo>
