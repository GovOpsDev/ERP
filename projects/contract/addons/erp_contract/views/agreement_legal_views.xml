<odoo>
<record id="agreement_legal_form" model="ir.ui.view"><field name="name">erp.contract.agreement.legal.form</field><field name="model">erp.contract.agreement</field><field name="inherit_id" ref="erp_contract.agreement_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_mark_reviewed" type="object" string="Record Review" groups="erp_contract.group_contract_manager"/><button name="action_mark_approved" type="object" string="Record Legal Approval" groups="erp_contract.group_contract_manager"/></xpath><xpath expr="//sheet/group[1]" position="before"><group string="Review and Legal Approval"><group><field name="reviewed_user_id"/><field name="reviewed_date" widget="thai_agreement_date"/></group><group><field name="approved_user_id"/><field name="approved_date" widget="thai_agreement_date"/></group></group></xpath><xpath expr="//sheet" position="inside"><group string="Legal Administration"><field name="stage_id"/><field name="type_id"/><field name="subtype_id" domain="[('type_id', '=', type_id)]"/><field name="assigned_user_id"/><field name="company_contact_id"/><field name="partner_contact_id"/><field name="notification_address_id"/></group><notebook><page string="Legal Content"><field name="description"/><field name="parties"/><field name="special_terms"/><field name="legal_item_ids"><list editable="bottom" open_form_view="1"><field name="sequence" widget="handle"/><field name="kind"/><field name="name"/><field name="title"/><field name="section_id" domain="[('agreement_id', '=', parent.id), ('kind', '=', 'section')]"/><field name="active"/></list><form><group><field name="kind"/><field name="name"/><field name="title"/><field name="section_id"/><field name="sequence"/><field name="active"/></group><field name="content"/><field name="dynamic_content"/></form></field></page><page string="Signatures and Review"><group><field name="company_signed_user_id"/><field name="company_signed_date" widget="thai_agreement_date"/><field name="partner_signed_user_id"/><field name="partner_signed_date" widget="thai_agreement_date"/><field name="signed_contract" filename="signed_contract_filename"/><field name="signed_contract_filename" invisible="1"/><field name="to_review_date" widget="thai_agreement_date"/></group></page></notebook></xpath><xpath expr="//form" position="inside"><chatter/></xpath></field></record>
<record id="agreement_legal_stage_action" model="ir.actions.act_window"><field name="name">Agreement Legal Stages</field><field name="res_model">erp.contract.agreement.stage</field><field name="view_mode">list,form</field></record>
<record id="agreement_legal_type_action" model="ir.actions.act_window"><field name="name">Agreement Legal Types</field><field name="res_model">erp.contract.agreement.type</field><field name="view_mode">list,form</field></record>
<record id="agreement_legal_subtype_action" model="ir.actions.act_window"><field name="name">Agreement Legal Subtypes</field><field name="res_model">erp.contract.agreement.subtype</field><field name="view_mode">list,form</field></record>
<record id="agreement_legal_revision_form" model="ir.ui.view"><field name="name">erp.contract.agreement.revision.legal</field><field name="model">erp.contract.agreement.revision</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="agreement_id"/><field name="version"/><field name="name"/><field name="start_date" widget="thai_agreement_date"/><field name="end_date" widget="thai_agreement_date"/><field name="signature_date" widget="thai_agreement_date"/><field name="signed_contract" widget="binary" filename="signed_contract_filename" invisible="not signed_contract"/><field name="signed_contract_filename" invisible="1"/><div class="text-muted" invisible="signed_contract">No signed agreement file was recorded.</div></group><field name="legal_snapshot" widget="agreement_revision_snapshot" nolabel="1" readonly="1"/></sheet></form></field></record>
<record id="cron_agreement_reviews" model="ir.cron"><field name="name">Agreement expiry review activities</field><field name="model_id" ref="model_erp_contract_agreement"/><field name="state">code</field><field name="code">model._cron_agreement_reviews()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="active" eval="True"/></record>
<menuitem id="menu_legal_stages" name="Legal Stages" parent="agreement_root" action="agreement_legal_stage_action" groups="erp_contract.group_contract_manager"/>
<menuitem id="menu_legal_types" name="Legal Types" parent="agreement_root" action="agreement_legal_type_action" groups="erp_contract.group_contract_manager"/>
<menuitem id="menu_legal_subtypes" name="Legal Subtypes" parent="agreement_root" action="agreement_legal_subtype_action" groups="erp_contract.group_contract_manager"/>
</odoo>
