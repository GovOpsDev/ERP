<odoo>
    <record id="agreement_list" model="ir.ui.view"><field name="name">erp.contract.agreement.list</field><field name="model">erp.contract.agreement</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="partner_id"/><field name="purchase_order_id"/><field name="organization_id"/><field name="end_date" widget="thai_agreement_date"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="agreement_form" model="ir.ui.view"><field name="name">erp.contract.agreement.form</field><field name="model">erp.contract.agreement</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activate" groups="erp_contract.group_contract_manager" invisible="state != 'draft'"/><button name="action_new_version" type="object" string="New Version" groups="erp_contract.group_contract_manager" invisible="state != 'active'"/><button name="action_terminate" type="object" string="Terminate" groups="erp_contract.group_contract_manager" invisible="state != 'active'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="organization_id"/><field name="partner_id"/><field name="purchase_order_id"/><field name="currency_id" invisible="1"/><field name="amount_untaxed"/><field name="start_date" widget="thai_agreement_date"/><field name="end_date" widget="thai_agreement_date"/><field name="signature_date" widget="thai_agreement_date"/><field name="is_expired"/><field name="termination_date" widget="thai_agreement_date"/><field name="version"/></group><field name="revision_ids"><list create="0" edit="0" delete="0"><field name="version"/><field name="name"/><field name="start_date" widget="thai_agreement_date"/><field name="end_date" widget="thai_agreement_date"/><field name="signature_date" widget="thai_agreement_date"/><field name="currency_id"/><field name="amount_untaxed"/></list></field></sheet></form></field></record>
    <record id="agreement_action" model="ir.actions.act_window"><field name="name">Purchase Agreements</field><field name="res_model">erp.contract.agreement</field><field name="view_mode">list,form</field></record>
    <menuitem id="agreement_root" name="Agreements" groups="erp_contract.group_contract_user" sequence="50"/><menuitem id="agreement_menu" name="Agreements" parent="agreement_root" action="agreement_action"/>
    <record id="purchase_order_form" model="ir.ui.view"><field name="name">purchase.order.agreement.form</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="erp_agreement_required"/></xpath></field></record>
</odoo>
