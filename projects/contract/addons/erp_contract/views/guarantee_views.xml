<odoo>
 <record id="guarantee_sequence" model="ir.sequence"><field name="name">Purchase Guarantee</field><field name="code">erp.contract.guarantee</field><field name="prefix">GUA/</field><field name="padding">6</field></record>
 <record id="guarantee_list" model="ir.ui.view"><field name="name">erp.contract.guarantee.list</field><field name="model">erp.contract.guarantee</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="organization_id"/><field name="amount"/><field name="amount_received"/><field name="amount_returned"/><field name="currency_id" column_invisible="1"/><field name="date_due_guarantee"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="guarantee_form" model="ir.ui.view"><field name="name">erp.contract.guarantee.form</field><field name="model">erp.contract.guarantee</field><field name="arch" type="xml"><form><header><button name="action_create_receipt" type="object" string="Create Receipt Invoice" groups="account.group_account_invoice"/><button name="action_create_return" type="object" string="Create Return Bill" groups="account.group_account_invoice"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="organization_id"/><field name="purchase_order_id"/><field name="requisition_id"/><field name="partner_id"/><field name="method_id"/><field name="type_id"/><field name="currency_id" invisible="1"/><field name="amount"/><field name="date_guarantee_receive"/><field name="document_ref"/><field name="date_due_guarantee"/><field name="document_return_date"/><field name="date_return"/><field name="amount_received"/><field name="amount_returned"/><field name="fund_id"/><field name="analytic_distribution" widget="analytic_distribution"/><field name="active"/></group><field name="move_ids" readonly="1" groups="account.group_account_invoice"/><field name="note"/></sheet><chatter/></form></field></record>
 <record id="guarantee_action" model="ir.actions.act_window"><field name="name">Purchase Guarantees</field><field name="res_model">erp.contract.guarantee</field><field name="view_mode">list,form</field></record>
 <record id="guarantee_method_action" model="ir.actions.act_window"><field name="name">Guarantee Methods</field><field name="res_model">erp.contract.guarantee.method</field><field name="view_mode">list,form</field></record>
 <record id="guarantee_type_action" model="ir.actions.act_window"><field name="name">Guarantee Instruments</field><field name="res_model">erp.contract.guarantee.type</field><field name="view_mode">list,form</field></record>
 <menuitem id="guarantee_menu_root" name="Purchase Guarantees" groups="erp_contract.group_contract_user" sequence="62"/>
 <menuitem id="guarantee_menu" name="Guarantees" parent="guarantee_menu_root" action="guarantee_action"/>
 <menuitem id="guarantee_method_menu" name="Methods" parent="guarantee_menu_root" action="guarantee_method_action" groups="erp_contract.group_contract_manager"/>
 <menuitem id="guarantee_type_menu" name="Instruments" parent="guarantee_menu_root" action="guarantee_type_action" groups="erp_contract.group_contract_manager"/>
 <record id="guarantee_move_form" model="ir.ui.view"><field name="name">account.move.guarantee</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="(//field[@name='journal_id'])[1]" position="after"><field name="erp_guarantee_id" invisible="not erp_guarantee_id"/><field name="erp_guarantee_direction" invisible="not erp_guarantee_id"/></xpath></field></record>
</odoo>
