<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="erp_contract.AgreementRevisionSnapshot">
        <div class="o_agreement_revision_snapshot w-100">
            <t t-if="this.hasSnapshot">
                <t t-foreach="this.groups" t-as="group" t-key="group.title">
                    <h5 class="mt-3" t-out="group.title"/>
                    <dl class="row mb-2">
                        <t t-foreach="group.rows" t-as="row" t-key="row.key">
                            <dt class="col-sm-4 fw-normal text-muted" t-out="row.label"/>
                            <dd class="col-sm-8" style="white-space: pre-wrap; overflow-wrap: anywhere" t-out="row.value"/>
                        </t>
                    </dl>
                </t>
                <h5 class="mt-3">Legal Items</h5>
                <p t-if="!this.items.length" class="text-muted">No legal items were recorded.</p>
                <t t-foreach="this.items" t-as="item" t-key="item.key">
                    <div class="border rounded p-2 mb-2">
                        <strong t-out="item.name"/>
                        <dl class="row mb-0 mt-2">
                            <dt class="col-sm-4 fw-normal text-muted">Kind</dt><dd class="col-sm-8" t-out="item.kind"/>
                            <dt class="col-sm-4 fw-normal text-muted">Title</dt><dd class="col-sm-8" t-out="item.title"/>
                            <dt class="col-sm-4 fw-normal text-muted">Section</dt><dd class="col-sm-8" t-out="item.section"/>
                            <dt class="col-sm-4 fw-normal text-muted">Sequence</dt><dd class="col-sm-8" t-out="item.sequence"/>
                            <dt class="col-sm-4 fw-normal text-muted">Status</dt><dd class="col-sm-8" t-out="item.active"/>
                            <dt class="col-sm-4 fw-normal text-muted">Content</dt><dd class="col-sm-8" style="white-space: pre-wrap; overflow-wrap: anywhere" t-out="item.content"/>
                        </dl>
                    </div>
                </t>
            </t>
            <p t-else="" class="text-muted">No legal details were recorded for this version.</p>
        </div>
    </t>
</templates>
