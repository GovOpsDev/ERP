#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
msgid "An active contract with uncommitted lines is required."
msgstr "ต้องมีสัญญาที่ใช้งานอยู่และมีรายการที่ยังไม่ผูกพัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
