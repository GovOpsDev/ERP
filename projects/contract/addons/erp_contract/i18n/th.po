#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/account_move.py:0
msgid "A bill line cannot consume both contract and purchase budget sources."
msgstr "รายการใบเรียกเก็บเงินไม่สามารถใช้งบประมาณจากสัญญาและการจัดซื้อพร้อมกัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/agreement_legal.py:0
msgid "A clause section must belong to the same agreement."
msgstr "หมวดของข้อสัญญาต้องอยู่ในข้อตกลงเดียวกัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
msgid "A contract bill must match the vendor, company and company currency."
msgstr "ใบเรียกเก็บเงินตามสัญญาต้องตรงกับผู้ขาย บริษัท และสกุลเงินบริษัท"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/account_move.py:0
msgid "A contract line cannot be added to a posted bill."
msgstr "ไม่สามารถเพิ่มรายการสัญญาในใบเรียกเก็บเงินที่ลงบัญชีแล้ว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/account_move.py:0
msgid "A contract line cannot be attached to a posted bill."
msgstr "ไม่สามารถเชื่อมรายการสัญญากับใบเรียกเก็บเงินที่ลงบัญชีแล้ว"

#. module: erp_contract
#: model:ir.model.constraint,message:erp_contract.constraint_erp_contract_line_successor_unique
msgid "A contract line has only one historical successor."
msgstr "รายการสัญญามีรายการสืบทอดในประวัติได้เพียงหนึ่งรายการ"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
msgid "A contract organization is required."
msgstr "ต้องระบุหน่วยงานของสัญญา"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/invoice_plan.py:0
msgid "A contract plan cannot also link a purchase order."
msgstr "แผนสัญญาไม่สามารถเชื่อมใบสั่งซื้อพร้อมกัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
msgid "A contract refund must reference a posted bill."
msgstr "การคืนเงินตามสัญญาต้องอ้างอิงใบเรียกเก็บเงินที่ลงบัญชีแล้ว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A contract with one-time financial history cannot become recurring."
msgstr "สัญญาที่มีประวัติการเงินแบบครั้งเดียวไม่สามารถเปลี่ยนเป็นแบบประจำ"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/guarantee.py:0
msgid "A guarantee method with financial history cannot change account or company."
msgstr "วิธีค้ำประกันที่มีประวัติการเงินแล้วไม่สามารถเปลี่ยนบัญชีหรือบริษัท"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/guarantee.py:0
msgid "A guarantee with accounting history cannot be deleted."
msgstr "ไม่สามารถลบหลักประกันที่มีประวัติทางบัญชี"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/contract.py:0
msgid "A positive quantity and matching product are required."
msgstr "ต้องระบุจำนวนมากกว่าศูนย์และสินค้าที่ตรงกัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A recurring credit must reference its posted period bill."
msgstr "ใบลดหนี้ประจำต้องอ้างอิงใบเรียกเก็บเงินประจำงวดที่ลงบัญชีแล้ว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A recurring credit must retain its original bill taxes."
msgstr "ใบลดหนี้ประจำต้องคงภาษีตามใบเรียกเก็บเงินต้นฉบับ"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A recurring line and end date are required."
msgstr "ต้องระบุรายการที่เกิดซ้ำและวันที่สิ้นสุด"

#. module: erp_contract
#: model:ir.model.constraint,message:erp_contract.constraint_erp_contract_cycle_period_unique
msgid "A recurring period may only be generated once."
msgstr "งวดประจำสร้างได้เพียงครั้งเดียว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/agreement_legal.py:0
msgid "A section referenced by clauses must remain a section."
msgstr "รายการที่ข้อสัญญาอ้างอิงเป็นหมวดต้องคงสถานะเป็นหมวด"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/agreement.py:0
msgid "A signed, current draft agreement and a non-cancelled purchase order are required."
msgstr "ต้องมีข้อตกลงฉบับร่างปัจจุบันที่ลงนามแล้วและใบสั่งซื้อที่ยังไม่ยกเลิก"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A stop cannot shorten an already generated invoice period."
msgstr "การหยุดไม่สามารถลดช่วงเวลาวางบิลที่สร้างแล้ว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A successor must start later in the same contract."
msgstr "รายการสืบทอดต้องเริ่มภายหลังภายในสัญญาเดียวกัน"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A successor requires a valid later period on an active recurring contract."
msgstr "รายการสืบทอดต้องมีงวดภายหลังที่ถูกต้องในสัญญาประจำที่ใช้งานอยู่"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A terminated contract cannot receive new lines."
msgstr "ไม่สามารถเพิ่มรายการในสัญญาที่สิ้นสุดแล้ว"

#. module: erp_contract
#. odoo-python
#: code:addons/erp_contract/models/recurrence.py:0
msgid "A unique company fiscal period must cover the recurring invoice date."
msgstr "ต้องมีงวดงบประมาณของบริษัทเพียงงวดเดียวที่ครอบคลุมวันที่ออกใบแจ้งหนี้ประจำ"

