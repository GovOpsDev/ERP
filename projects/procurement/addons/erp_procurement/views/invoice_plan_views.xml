<odoo>
<record id="view_purchase_invoice_plan" model="ir.ui.view"><field name="name">purchase.order.invoice.plan</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Invoice Plan"><group><field name="erp_use_invoice_plan"/><field name="erp_plan_installments"/><field name="erp_plan_start"/><field name="erp_plan_interval"/><field name="erp_plan_interval_type"/><button name="action_create_invoice_plan" type="object" string="Generate Installments"/></group><field name="erp_invoice_plan_ids"><list editable="bottom"><field name="installment"/><field name="plan_date"/><field name="percent"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="invoice_ids" widget="many2many_tags"/><button name="action_create_invoice" type="object" string="Create / Open Invoice"/></list></field></page></xpath></field></record>
<record id="view_purchase_plan_move" model="ir.ui.view"><field name="name">account.move.purchase.invoice.plan</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='invoice_origin']" position="after"><field name="erp_purchase_invoice_plan_id" invisible="not erp_purchase_invoice_plan_id"/></xpath></field></record>
</odoo>
