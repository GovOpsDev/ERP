<odoo>
 <record id="government_request_form" model="ir.ui.view"><field name="name">erp.procurement.request.government.form</field><field name="model">erp.procurement.request</field><field name="inherit_id" ref="request_form"/><field name="arch" type="xml">
  <xpath expr="//header" position="inside"><button name="action_verify" type="object" string="Verify" invisible="state != 'to_approve' or verified_by_id" groups="erp_procurement.group_procurement_manager"/><button name="action_done" type="object" string="Done" invisible="state != 'approved'" groups="erp_procurement.group_procurement_manager"/><button name="action_reset" type="object" string="Reset to Draft" invisible="state == 'draft'"/></xpath>
  <xpath expr="//sheet" position="inside"><group string="Government Procurement"><field name="procurement_type_id" readonly="state != 'draft'"/><field name="purchase_type_id" readonly="state != 'draft'"/><field name="procurement_method_id" readonly="state != 'draft'"/><field name="conversion_route"/><field name="expense_reason" readonly="state != 'draft'"/><field name="assigned_to" readonly="state != 'draft'"/><field name="verified_by_id"/><field name="date_verified"/><field name="approved_by_id"/><field name="date_approved"/></group><field name="committee_ids" readonly="state != 'draft'"><list editable="bottom"><field name="employee_id"/><field name="name"/><field name="kind"/><field name="approve_role"/><field name="note"/></list></field></xpath>
  <xpath expr="//field[@name='review_ids']/list/field[@name='sequence']" position="before"><field name="round_number"/></xpath><xpath expr="//field[@name='review_ids']/list/field[@name='state']" position="after"><field name="decided_by_id"/><field name="decided_at"/><field name="verified_by_id" optional="hide"/><field name="date_verified" optional="hide"/></xpath>
 </field></record>
 <record id="government_requisition_form" model="ir.ui.view"><field name="name">purchase.requisition.government.form</field><field name="model">purchase.requisition</field><field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/><field name="arch" type="xml"><field name="vendor_id" position="after"><field name="erp_po_type" readonly="state != 'draft'"/></field></field></record>
 <record id="tier_kind_form" model="ir.ui.view"><field name="name">erp.procurement.tier.kind.form</field><field name="model">erp.procurement.tier</field><field name="inherit_id" ref="tier_form"/><field name="arch" type="xml"><field name="name" position="after"><field name="kind"/></field></field></record>
 <record id="tier_kind_list" model="ir.ui.view"><field name="name">erp.procurement.tier.kind.list</field><field name="model">erp.procurement.tier</field><field name="inherit_id" ref="tier_list"/><field name="arch" type="xml"><field name="name" position="after"><field name="kind"/></field></field></record>
 <record id="purchase_review_form" model="ir.ui.view"><field name="name">purchase.order.erp.review.form</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_request_tier_review" type="object" string="Request Tier Review" invisible="state not in ('draft', 'sent', 'to approve') or erp_review_status != 'none'"/><button name="action_approve_tier" type="object" string="Approve Tier" invisible="erp_review_status != 'pending'"/><button name="action_reject_tier" type="object" string="Reject Tier" invisible="erp_review_status != 'pending'"/><button name="action_reset_tier_review" type="object" string="Reset Reviews" invisible="erp_review_status == 'none' or state not in ('draft', 'sent', 'cancel')" groups="erp_procurement.group_procurement_manager"/></xpath><xpath expr="//notebook" position="inside"><page string="Approval Reviews"><field name="erp_review_status"/><field name="erp_review_ids"><list create="0" edit="0" delete="0"><field name="round_number"/><field name="sequence"/><field name="reviewer_id"/><field name="state"/><field name="decided_by_id"/><field name="decided_at"/></list></field></page></xpath></field></record>
 <record id="procurement_method_action" model="ir.actions.act_window"><field name="name">Procurement Methods</field><field name="res_model">erp.procurement.method</field><field name="view_mode">list,form</field></record>
 <record id="procurement_type_action" model="ir.actions.act_window"><field name="name">Procurement Categories</field><field name="res_model">erp.procurement.type</field><field name="view_mode">list,form</field></record>
 <record id="purchase_type_action" model="ir.actions.act_window"><field name="name">Purchase Types</field><field name="res_model">erp.procurement.purchase.type</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_procurement_methods" parent="menu_procurement_root" action="procurement_method_action" groups="erp_procurement.group_procurement_manager"/>
 <menuitem id="menu_procurement_types" parent="menu_procurement_root" action="procurement_type_action" groups="erp_procurement.group_procurement_manager"/>
 <menuitem id="menu_purchase_types" parent="menu_procurement_root" action="purchase_type_action" groups="erp_procurement.group_procurement_manager"/>
</odoo>
