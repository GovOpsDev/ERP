<odoo>
 <record id="request_requisition_form" model="ir.ui.view"><field name="name">erp.procurement.request.requisition.form</field><field name="model">erp.procurement.request</field><field name="inherit_id" ref="request_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_create_requisition" type="object" string="Create Purchase Agreement" invisible="state != 'approved'" groups="purchase.group_purchase_user"/></xpath></field></record>
 <record id="requisition_organization_form" model="ir.ui.view"><field name="name">purchase.requisition.erp.organization</field><field name="model">purchase.requisition</field><field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_create_rfq" type="object" string="Create RFQ" invisible="state != 'confirmed'"/></xpath><field name="vendor_id" position="after"><field name="erp_organization_id"/><field name="erp_budget_manual_rate" readonly="state != 'draft'" groups="erp_budget.group_budget_manager,account.group_account_manager"/></field><xpath expr="//field[@name='line_ids']/list/field[@name='product_qty']" position="after"><field name="erp_request_line_id" optional="show" readonly="1"/></xpath></field></record>
</odoo>
