<odoo>
    <record id="request_list" model="ir.ui.view"><field name="name">erp.procurement.request.list</field><field name="model">erp.procurement.request</field><field name="arch" type="xml"><list><field name="name"/><field name="requested_by"/><field name="organization_id"/><field name="date_start"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="request_form" model="ir.ui.view"><field name="name">erp.procurement.request.form</field><field name="model">erp.procurement.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" invisible="state != 'to_approve'" /><button name="action_reject" type="object" string="Reject" invisible="state not in ('to_approve', 'approved')" /><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="requested_by"/><field name="company_id" groups="base.group_multi_company"/><field name="organization_id"/><field name="date_start"/><field name="currency_id" readonly="state != 'draft'"/><field name="company_currency_id" invisible="1"/><field name="erp_budget_manual_rate" readonly="state != 'draft'" groups="erp_budget.group_budget_manager,account.group_account_manager"/><field name="erp_budget_fx_rate"/><field name="total_company_currency"/></group><field name="review_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="sequence"/><field name="reviewer_id"/><field name="state"/></list></field><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="name"/><field name="product_id"/><field name="product_qty"/><field name="estimated_cost"/><field name="currency_id" column_invisible="True"/><field name="company_currency_id" column_invisible="True"/><field name="estimated_cost_company_currency" optional="show"/><field name="period_id"/><field name="fund_id"/><field name="analytic_id"/><field name="activity_id"/><field name="account_id"/><field name="dimension_ids" widget="many2many_tags"/></list></field></sheet></form></field></record>
    <record id="action_requests" model="ir.actions.act_window"><field name="name">Purchase Requests</field><field name="res_model">erp.procurement.request</field><field name="view_mode">list,form</field></record>
    <record id="tier_list" model="ir.ui.view"><field name="name">erp.procurement.tier.list</field><field name="model">erp.procurement.tier</field><field name="arch" type="xml"><list><field name="name"/><field name="sequence"/><field name="minimum_amount"/><field name="reviewer_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="tier_form" model="ir.ui.view"><field name="name">erp.procurement.tier.form</field><field name="model">erp.procurement.tier</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="sequence"/><field name="minimum_amount"/><field name="reviewer_id"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_tiers" model="ir.actions.act_window"><field name="name">Approval Tiers</field><field name="res_model">erp.procurement.tier</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_procurement_root" name="Purchase Requests" groups="erp_procurement.group_procurement_user" sequence="90"/>
    <menuitem id="menu_tiers" name="Approval Tiers" parent="menu_procurement_root" action="action_tiers" groups="erp_procurement.group_procurement_manager"/>
    <menuitem id="menu_requests" name="Requests" parent="menu_procurement_root" action="action_requests"/>
</odoo>
