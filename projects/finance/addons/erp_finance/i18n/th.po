#: code:addons/erp_finance/models/advance.py:0
msgid "The advances have no amount remaining after approved clearings and returns."
msgstr "เงินทดรองไม่มียอดคงเหลือหลังรายการล้างและคืนที่อนุมัติแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "The bill must match the purchase company and supplier."
msgstr "ใบเรียกเก็บเงินต้องตรงกับบริษัทและผู้ขายในการจัดซื้อ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "The direct budget period must match the accounting company."
msgstr "งวดงบประมาณโดยตรงต้องตรงกับบริษัทบัญชี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid ""
"The employee advance account cannot change while advance documents retain that source identity."
msgstr "ไม่สามารถเปลี่ยนบัญชีเงินทดรองพนักงานขณะที่เอกสารเงินทดรองยังอ้างอิงต้นทางนั้น"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "The linked purchase order and request must be approved."
msgstr "ใบสั่งซื้อและคำขอที่เชื่อมโยงต้องได้รับอนุมัติ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "The native payment must post one retained balance."
msgstr "รายการชำระเงินของระบบต้องลงบัญชียอดเงินประกันผลงานหนึ่งรายการ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "The original deposit bill must retain its purchase provenance."
msgstr "ใบเรียกเก็บเงินมัดจำต้นฉบับต้องคงที่มาการจัดซื้อ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "The request is assigned to an expense; refuse that expense before purchasing."
msgstr "คำขอนี้เชื่อมกับค่าใช้จ่ายแล้ว ต้องปฏิเสธค่าใช้จ่ายนั้นก่อนจัดซื้อ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "The request must belong to the expense employee, organization and company."
msgstr "คำขอต้องเป็นของพนักงาน หน่วยงาน และบริษัทเดียวกับค่าใช้จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "The requester needs one visible employee in the request company."
msgstr "ผู้ร้องขอต้องมีข้อมูลพนักงานที่มองเห็นได้หนึ่งรายการในบริษัทของคำขอ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "The return exceeds the remaining advance after approved clearings."
msgstr "ยอดคืนเกินเงินทดรองคงเหลือหลังหักรายการล้างเงินที่อนุมัติแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "This government purchase type must use the purchase agreement route."
msgstr "ประเภทจัดซื้อภาครัฐนี้ต้องใช้เส้นทางข้อตกลงจัดซื้อ"

#. module: erp_finance
#: model:ir.model.fields.selection,name:erp_finance.selection__account_move__erp_retention_method__total
#: model:ir.model.fields.selection,name:erp_finance.selection__purchase_order__erp_retention_method__total
msgid "Total"
msgstr "รวม"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "Unreconcile retention payments instead of rewriting history."
msgstr "ให้ยกเลิกการกระทบยอดการชำระเงินประกันผลงานแทนการแก้ประวัติ"

#. module: erp_finance
#: model:ir.model.fields.selection,name:erp_finance.selection__account_move__erp_retention_method__untax
#: model:ir.model.fields.selection,name:erp_finance.selection__purchase_order__erp_retention_method__untax
msgid "Untaxed amount"
msgstr "จำนวนเงินก่อนภาษี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid ""
"Use an unassigned positive deposit bill line for the same company and supplier, with quantity one."
msgstr ""
"ใช้รายการใบเรียกเก็บเงินมัดจำที่ยังไม่กำหนด มีจำนวนเงินบวก อยู่ในบริษัทและผู้ขายเดียวกัน "
"และมีจำนวนหนึ่ง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "Use native accounting actions to reset budget actuals."
msgstr "ให้ใช้คำสั่งบัญชีของระบบเพื่อคืนสถานะค่าใช้จ่ายจริงงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "Use native accounting reset before changing expense actuals."
msgstr "ต้องคืนสถานะบัญชีของระบบก่อนเปลี่ยนค่าใช้จ่ายจริง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "Use native bill matching to add a controlled deposit."
msgstr "ให้ใช้การจับคู่ใบเรียกเก็บเงินของระบบเพื่อเพิ่มเงินมัดจำที่ควบคุมงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "Use native expense approval and accounting actions."
msgstr "ให้ใช้คำสั่งอนุมัติค่าใช้จ่ายและบัญชีของระบบ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "Use native posting to reconcile the controlled deposit."
msgstr "ให้ลงบัญชีผ่านระบบเพื่อกระทบยอดเงินมัดจำที่ควบคุมงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "Use native posting/reset actions for retention release documents."
msgstr "ให้ใช้คำสั่งลงบัญชีหรือคืนสถานะของระบบสำหรับเอกสารคืนเงินประกันผลงาน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Use the advance-reservation KPI only for employee advances; clearing uses its expense KPI."
msgstr "ใช้ตัวชี้วัดกันเงินทดรองเฉพาะเงินทดรองพนักงาน ส่วนการล้างเงินใช้ตัวชี้วัดค่าใช้จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "Use the native accounting actions to reset or cancel a controlled bill."
msgstr "ให้ใช้คำสั่งบัญชีของระบบเพื่อคืนสถานะหรือยกเลิกใบเรียกเก็บเงินที่ควบคุมงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "Use the native bill matching wizard to assign deposit provenance."
msgstr "ให้ใช้ตัวช่วยจับคู่ใบเรียกเก็บเงินของระบบเพื่อกำหนดที่มาเงินมัดจำ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "Use the native matching wizard to attach a posted deposit."
msgstr "ให้ใช้ตัวช่วยจับคู่ของระบบเพื่อเชื่อมเงินมัดจำที่ลงบัญชีแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Withhold on the clearing expense, not on the advance."
msgstr "ให้หัก ณ ที่จ่ายจากค่าใช้จ่ายล้างเงิน ไม่ใช่จากเงินทดรอง"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_hr_expense__erp_withholding_payment_ids
msgid "Withholding Payments"
msgstr "การหักเงิน ณ ที่จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Withholding history cannot be supplied by clients."
msgstr "ผู้ใช้ไม่สามารถระบุประวัติหัก ณ ที่จ่ายเอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Withholding history is generated by expense posting."
msgstr "ระบบสร้างประวัติหัก ณ ที่จ่ายเมื่อลงบัญชีค่าใช้จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Withholding requires a supplier belonging to this company or shared across companies."
msgstr "การหัก ณ ที่จ่ายต้องใช้ผู้ขายของบริษัทนี้หรือผู้ขายที่ใช้ร่วมกันหลายบริษัท"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Withholding requires one employee payable account and partner."
msgstr "การหัก ณ ที่จ่ายต้องมีบัญชีเจ้าหนี้พนักงานและคู่ค้าหนึ่งรายการ"
