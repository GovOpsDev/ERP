#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "A clearing receipt must have one employee payable account."
msgstr "เอกสารล้างเงินต้องมีบัญชีเจ้าหนี้พนักงานหนึ่งบัญชี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "A controlled deposit line cannot change its source or amount."
msgstr "รายการเงินมัดจำที่ควบคุมงบประมาณไม่สามารถเปลี่ยนแหล่งที่มาหรือจำนวนเงิน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "A controlled expense must begin in draft."
msgstr "ค่าใช้จ่ายที่ควบคุมงบประมาณต้องเริ่มจากสถานะร่าง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "A controlled expense must have a positive company-currency amount."
msgstr "ค่าใช้จ่ายที่ควบคุมงบประมาณต้องมีจำนวนเงินสกุลบริษัทมากกว่าศูนย์"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "A controlled expense requires period, organization, fund, analytic and account."
msgstr "ค่าใช้จ่ายที่ควบคุมงบประมาณต้องระบุงวด หน่วยงาน แหล่งเงิน บัญชีวิเคราะห์ และบัญชี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "A controlled refund must reverse a vendor bill."
msgstr "การคืนเงินที่ควบคุมงบประมาณต้องกลับรายการใบเรียกเก็บเงินผู้ขาย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "A deposit has one original bill; create another deposit for an additional payment."
msgstr "เงินมัดจำหนึ่งรายการมีใบเรียกเก็บเงินต้นฉบับได้หนึ่งใบ หากชำระเพิ่มให้สร้างเงินมัดจำใหม่"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/invoice_plan.py:0
msgid ""
"A deposit installment uses number zero or a negative number and an approved line from its "
"purchase."
msgstr "งวดเงินมัดจำต้องใช้เลขศูนย์หรือเลขติดลบ และรายการจัดซื้อที่อนุมัติแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/purchase_deposit.py:0
msgid "A deposit refund must reverse its posted deposit or deduction bill."
msgstr "การคืนเงินมัดจำต้องกลับรายการใบมัดจำหรือใบหักเงินที่ลงบัญชีแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "A direct budget line requires period, organization, fund, analytic and account."
msgstr "รายการงบประมาณโดยตรงต้องระบุงวด หน่วยงาน แหล่งเงิน บัญชีวิเคราะห์ และบัญชี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "A new draft return for a posted advance is required."
msgstr "ต้องมีรายการคืนใหม่สถานะร่างสำหรับเงินทดรองที่ลงบัญชีแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "A positive bill quantity, matching product and compatible unit are required."
msgstr "ต้องระบุจำนวนในใบเรียกเก็บเงินมากกว่าศูนย์ สินค้าที่ตรงกัน และหน่วยที่ใช้ร่วมกันได้"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "A posted advance with remaining funds is required."
msgstr "ต้องมีเงินทดรองที่ลงบัญชีแล้วและมียอดคงเหลือ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "A posted employee advance is required."
msgstr "ต้องมีเงินทดรองพนักงานที่ลงบัญชีแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/budget_exemption.py:0
msgid ""
"A purchase or contract commitment must be reconciled; use a separate direct entry for an exempt "
"accounting adjustment."
msgstr ""
"ต้องกระทบยอดภาระผูกพันจากการจัดซื้อหรือสัญญา "
"หากเป็นการปรับปรุงบัญชีที่ได้รับยกเว้นให้ใช้รายการตรงแยกต่างหาก"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "A refund must reference a posted bill for the same purchase line."
msgstr "การคืนเงินต้องอ้างอิงใบเรียกเก็บเงินที่ลงบัญชีแล้วของรายการจัดซื้อเดียวกัน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "A request line can be taken over by only one approved expense or advance."
msgstr "รายการคำขอหนึ่งรายการเชื่อมกับค่าใช้จ่ายหรือเงินทดรองที่อนุมัติได้เพียงรายการเดียว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "A return requires a positive amount and a configured bank or cash journal."
msgstr "การคืนเงินต้องมีจำนวนเงินมากกว่าศูนย์และสมุดรายวันธนาคารหรือเงินสดที่กำหนดไว้"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "A submitted or historical expense must retain its request source."
msgstr "ค่าใช้จ่ายที่ส่งแล้วหรือเป็นประวัติต้องคงคำขอต้นทาง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/budget_amount.py:0
msgid "A taxed budget actual requires a native accounting tax base."
msgstr "ค่าใช้จ่ายจริงที่รวมภาษีต้องมีฐานภาษีจากระบบบัญชี"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "Accounting lines with budget history cannot be deleted."
msgstr "ไม่สามารถลบรายการบัญชีที่มีประวัติงบประมาณ"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_erp_finance_advance_return__advance_id
msgid "Advance"
msgstr "เงินทดรอง"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_res_company__erp_employee_advance_journal_id
#: model:ir.model.fields,field_description:erp_finance.field_res_config_settings__erp_employee_advance_journal_id
#: model_terms:ir.ui.view,arch_db:erp_finance.advance_settings
msgid "Advance Settlement Journal"
msgstr "สมุดรายวันล้างเงินทดรอง"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_hr_expense__erp_advance_settlement_ids
msgid "Advance Settlements"
msgstr "การล้างเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance accounting is managed by its source workflow."
msgstr "การบัญชีเงินทดรองจัดการโดยขั้นตอนของเอกสารต้นทาง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance accounting lines are created by source workflows."
msgstr "รายการบัญชีเงินทดรองสร้างจากขั้นตอนของเอกสารต้นทาง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance accounting lines are retained for audit."
msgstr "เก็บรายการบัญชีเงินทดรองไว้เพื่อตรวจสอบ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance accounting origins are created only by the source workflow."
msgstr "ที่มาทางบัญชีของเงินทดรองสร้างได้โดยขั้นตอนต้นทางเท่านั้น"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance accounting origins are immutable."
msgstr "ไม่สามารถแก้ไขที่มาทางบัญชีของเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance and clearing source identities with approval history cannot be changed."
msgstr "ไม่สามารถเปลี่ยนตัวระบุต้นทางของเงินทดรองและการล้างเงินที่มีประวัติอนุมัติ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "Advance clearing uses its advance origin, not another purchase request."
msgstr "การล้างเงินทดรองต้องใช้เงินทดรองต้นทาง ไม่ใช่คำขอซื้ออื่น"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance returns begin in draft with derived scope."
msgstr "รายการคืนเงินทดรองต้องเริ่มจากสถานะร่างโดยใช้ขอบเขตจากต้นทาง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance settlement amounts and origins are immutable."
msgstr "ไม่สามารถแก้ไขจำนวนเงินและต้นทางของการล้างเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance settlement and return accounting history cannot be deleted."
msgstr "ไม่สามารถลบประวัติทางบัญชีของการล้างและคืนเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance settlement history cannot be supplied by clients."
msgstr "ผู้ใช้ไม่สามารถระบุประวัติการล้างเงินทดรองเอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advance settlements are created only by native posting."
msgstr "รายการล้างเงินทดรองสร้างได้จากการลงบัญชีของระบบเท่านั้น"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Advances are employee-paid, tax-free and cannot clear other advances."
msgstr "เงินทดรองจ่ายให้พนักงาน ไม่รวมภาษี และใช้ล้างเงินทดรองอื่นไม่ได้"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_hr_expense__erp_request_amount_override
msgid "Allow Expense Above Request"
msgstr "อนุญาตค่าใช้จ่ายเกินคำขอ"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_erp_finance_advance_return__amount
#: model:ir.model.fields,field_description:erp_finance.field_erp_finance_retention__amount
#: model:ir.model.fields.selection,name:erp_finance.selection__account_move__erp_payment_retention__amount
#: model:ir.model.fields.selection,name:erp_finance.selection__purchase_order__erp_payment_retention__amount
msgid "Amount"
msgstr "จำนวนเงิน"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_erp_finance_retention__amount_remaining
msgid "Amount Remaining"
msgstr "จำนวนเงินคงเหลือ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "An accounting line with budget history cannot move to another document."
msgstr "รายการบัญชีที่มีประวัติงบประมาณไม่สามารถย้ายไปเอกสารอื่น"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "An advance requires the configured reconcilable current-asset employee advance account."
msgstr "เงินทดรองต้องใช้บัญชีสินทรัพย์หมุนเวียนเงินทดรองพนักงานที่ตั้งค่าให้กระทบยอดได้"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_request.py:0
msgid "An approved request configured for expense conversion is required."
msgstr "ต้องมีคำขอที่อนุมัติแล้วและกำหนดให้แปลงเป็นค่าใช้จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense.py:0
msgid "An expense accounting source with budget history cannot be reassigned."
msgstr "ไม่สามารถเปลี่ยนแหล่งบัญชีค่าใช้จ่ายที่มีประวัติงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Applied advance return history cannot be deleted."
msgstr "ไม่สามารถลบประวัติการคืนเงินทดรองที่ดำเนินการแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Applied return history is immutable."
msgstr "ไม่สามารถแก้ไขประวัติรายการคืนที่ดำเนินการแล้ว"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_account_payment_register__erp_apply_retention
msgid "Apply Retention"
msgstr "หักเงินประกันผลงาน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "Apply the suggested retention or explicitly disable its enforcement."
msgstr "ให้ใช้เงินประกันผลงานที่แนะนำหรือปิดการบังคับใช้อย่างชัดเจน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/expense_withholding.py:0
msgid "Approve and post the original expense before withholding."
msgstr "ต้องอนุมัติและลงบัญชีค่าใช้จ่ายต้นฉบับก่อนหักเงิน ณ ที่จ่าย"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "Bill and purchase units must have the same reference unit."
msgstr "หน่วยของใบเรียกเก็บเงินและการจัดซื้อต้องมีหน่วยอ้างอิงเดียวกัน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/finance.py:0
msgid "Bill taxes, account or analytic distribution do not match the supported purchase budget key."
msgstr ""
"ภาษี บัญชี หรือการกระจายบัญชีวิเคราะห์ในใบเรียกเก็บเงินไม่ตรงกับรหัสงบประมาณจัดซื้อที่รองรับ"

#. module: erp_finance
#: model:ir.model,name:erp_finance.model_bill_to_po_wizard
msgid "Bill to Purchase Order"
msgstr "เชื่อมใบเรียกเก็บเงินกับใบสั่งซื้อ"

#. module: erp_finance
#: model_terms:ir.ui.view,arch_db:erp_finance.expense_budget_form
msgid "Budget"
msgstr "งบประมาณ"

#. module: erp_finance
#: model:ir.model,name:erp_finance.model_erp_budget_activity
msgid "Budget Activity"
msgstr "กิจกรรมงบประมาณ"

#. module: erp_finance
#: model:ir.model,name:erp_finance.model_erp_budget_kpi_tier
msgid "Budget Release Reviewer Configuration"
msgstr "การกำหนดผู้ตรวจทานการปล่อยงบ"

#. module: erp_finance
#: model_terms:ir.ui.view,arch_db:erp_finance.expense_budget_form
msgid "Budget Reviews"
msgstr "การตรวจทานงบประมาณ"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/budget_exemption.py:0
msgid "Budget or accounting management authority is required to override the journal budget policy."
msgstr "ต้องมีอำนาจจัดการงบประมาณหรือบัญชีเพื่อเปลี่ยนนโยบายงบประมาณของสมุดรายวัน"

#. module: erp_finance
#: model_terms:ir.ui.view,arch_db:erp_finance.advance_return_form
msgid "Cancel"
msgstr "ยกเลิก"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "Cancel accounting documents while retaining the retention history."
msgstr "ให้ยกเลิกเอกสารบัญชีโดยคงประวัติเงินประกันผลงานไว้"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Cancel advance clearings and returns before resetting or reversing the advance."
msgstr "ต้องยกเลิกรายการล้างและคืนเงินทดรองก่อนคืนสถานะหรือกลับรายการเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/retention.py:0
msgid "Cancel retention releases before removing their source payment or reconciliation."
msgstr "ต้องยกเลิกการคืนเงินประกันผลงานก่อนนำรายการชำระเงินหรือการกระทบยอดต้นทางออก"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Cancel the original clearing or return document."
msgstr "ให้ยกเลิกเอกสารล้างเงินหรือคืนเงินต้นฉบับ"

#. module: erp_finance
#: model:ir.model.fields.selection,name:erp_finance.selection__erp_finance_advance_return__state__cancel
msgid "Cancelled"
msgstr "ยกเลิกแล้ว"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/direct_actual.py:0
msgid "Choose the purchase, contract or expense source, or direct budget dimensions for a line."
msgstr "เลือกแหล่งจัดซื้อ สัญญา ค่าใช้จ่าย หรือมิติงบประมาณโดยตรงสำหรับรายการ"

#. module: erp_finance
#: model_terms:ir.ui.view,arch_db:erp_finance.expense_advance_form
msgid "Clear Advance"
msgstr "ล้างเงินทดรอง"

#. module: erp_finance
#: model:ir.model.fields,field_description:erp_finance.field_hr_expense__erp_advance_ids
msgid "Clear Advances"
msgstr "ล้างเงินทดรอง"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid "Clear Employee Advance"
msgstr "ล้างเงินทดรองพนักงาน"

#. module: erp_finance
#. odoo-python
#: code:addons/erp_finance/models/advance.py:0
msgid ""
"Clearing requires employee-paid expenses and advances for the same company, employee and "
"organization."
msgstr "การล้างเงินต้องใช้ค่าใช้จ่ายที่พนักงานจ่ายและเงินทดรองของบริษัท พนักงาน และหน่วยงานเดียวกัน"

#. module: erp_finance
