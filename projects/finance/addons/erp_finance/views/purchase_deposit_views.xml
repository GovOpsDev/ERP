<odoo>
    <record id="bill_to_po_budget_source_form" model="ir.ui.view">
        <field name="name">bill.to.po.budget.source.form</field>
        <field name="model">bill.to.po.wizard</field>
        <field name="inherit_id" ref="purchase.bill_to_po_wizard_form"/>
        <field name="arch" type="xml">
            <field name="purchase_order_id" position="after">
                <field name="erp_deposit_origin_id" invisible="not purchase_order_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
