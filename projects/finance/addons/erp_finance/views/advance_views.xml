<odoo>
<record id="expense_advance_form" model="ir.ui.view"><field name="name">expense.advance.form</field><field name="model">hr.expense</field><field name="inherit_id" ref="hr_expense.hr_expense_view_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Employee Advance" groups="erp_budget.group_budget_user"><field name="erp_is_advance" readonly="approval_state in ('submitted', 'approved')"/><field name="erp_advance_ids" widget="many2many_tags" domain="[('erp_is_advance','=',True),('company_id','=',company_id),('employee_id','=',employee_id)]" readonly="approval_state in ('submitted', 'approved')" invisible="erp_is_advance"/><field name="erp_advance_remaining" invisible="not erp_is_advance"/><field name="erp_clearing_product_id" invisible="not erp_is_advance" readonly="approval_state in ('submitted','approved')"/><field name="erp_clearing_activity_id" invisible="not erp_is_advance" readonly="approval_state in ('submitted','approved')"/><button name="action_prepare_clearing" type="object" string="Clear Advance" invisible="not erp_is_advance or erp_advance_remaining &lt;= 0"/><button name="action_prepare_advance_return" type="object" string="Return Advance" groups="account.group_account_invoice" invisible="not erp_is_advance or erp_advance_remaining &lt;= 0"/><field name="erp_advance_settlement_ids" readonly="1"/></group></xpath></field></record>
<record id="advance_return_list" model="ir.ui.view"><field name="name">advance.return.list</field><field name="model">erp.finance.advance.return</field><field name="arch" type="xml"><list><field name="name"/><field name="advance_id"/><field name="date"/><field name="amount"/><field name="currency_id"/><field name="state"/></list></field></record>
<record id="advance_return_form" model="ir.ui.view"><field name="name">advance.return.form</field><field name="model">erp.finance.advance.return</field><field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Return Advance" invisible="state != 'draft'" class="oe_highlight"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="advance_id" domain="[('erp_is_advance','=',True)]" readonly="state != 'draft'"/><field name="company_id"/><field name="organization_id"/><field name="date" readonly="state != 'draft'"/><field name="journal_id" domain="[('type','in',['bank','cash'])]" readonly="state != 'draft'"/><field name="currency_id" readonly="state != 'draft'"/><field name="amount" readonly="state != 'draft'"/><field name="move_id"/></group></sheet></form></field></record>
<record id="advance_return_action" model="ir.actions.act_window"><field name="name">Employee Advance Returns</field><field name="res_model">erp.finance.advance.return</field><field name="view_mode">list,form</field></record>
<menuitem id="advance_return_menu" name="Employee Advance Returns" parent="hr_expense.menu_hr_expense_root" action="advance_return_action" groups="account.group_account_invoice"/>
<record id="advance_settings" model="ir.ui.view"><field name="name">advance.settings</field><field name="model">res.config.settings</field><field name="inherit_id" ref="account.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//app[@name='account']" position="inside"><block title="Employee Advances" groups="account.group_account_manager"><setting string="Employee Advance Account"><field name="erp_employee_advance_account_id" domain="[('account_type','=','asset_current'),('reconcile','=',True)]"/></setting><setting string="Advance Settlement Journal"><field name="erp_employee_advance_journal_id" domain="[('type','=','general')]"/></setting></block></xpath></field></record>
</odoo>
