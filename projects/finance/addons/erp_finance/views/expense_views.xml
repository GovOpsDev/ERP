<odoo>
  <record id="expense_budget_form" model="ir.ui.view">
    <field name="name">hr.expense.budget.form</field><field name="model">hr.expense</field>
    <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside"><group string="Budget" groups="erp_budget.group_budget_user">
        <field name="erp_request_line_id" readonly="approval_state" options="{'no_create': True}"/>
        <field name="erp_request_amount_override" groups="hr_expense.group_hr_expense_manager" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_organization_id" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_period_id" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_fund_id" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_analytic_id" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_activity_id" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_dimension_ids" widget="many2many_tags" readonly="approval_state == 'approved'"/>
        <field name="erp_budget_amount" invisible="not erp_budget_captured"/><field name="erp_budget_captured" invisible="1"/>
      </group><group string="Supplier Tax Evidence"><field name="erp_tax_invoice_reference" readonly="approval_state"/><field name="erp_tax_invoice_date" readonly="approval_state"/><field name="erp_withholding_payment_ids" readonly="1"/></group><group string="Budget Reviews" groups="erp_budget.group_budget_user"><field name="erp_review_round"/><field name="erp_review_ids"><list create="0" edit="0" delete="0"><field name="round_number"/><field name="sequence"/><field name="reviewer_id"/><field name="state"/></list></field></group></xpath>
    </field>
  </record>
</odoo>
