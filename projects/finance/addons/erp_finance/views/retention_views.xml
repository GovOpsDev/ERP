<odoo>
  <record id="view_retention_form" model="ir.ui.view"><field name="name">erp.finance.retention.form</field><field name="model">erp.finance.retention</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_release" type="object" string="Release Retention" class="oe_highlight"/></header><sheet><group><field name="source_move_id"/><field name="payment_id"/><field name="payment_line_id"/><field name="company_id"/><field name="organization_id"/><field name="currency_id" invisible="1"/><field name="amount"/><field name="amount_remaining"/></group><field name="release_ids"/></sheet></form></field></record>
  <record id="view_retention_list" model="ir.ui.view"><field name="name">erp.finance.retention.list</field><field name="model">erp.finance.retention</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="source_move_id"/><field name="payment_id"/><field name="company_id"/><field name="organization_id"/><field name="amount"/><field name="amount_remaining"/><field name="currency_id" column_invisible="True"/></list></field></record>
  <record id="action_retention" model="ir.actions.act_window"><field name="name">Payment Retentions</field><field name="res_model">erp.finance.retention</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_retention" name="Payment Retentions" parent="account.menu_finance_payables" action="action_retention" groups="account.group_account_invoice"/>
  <record id="view_move_retention" model="ir.ui.view"><field name="name">account.move.retention</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Payment Retention" invisible="move_type not in ('in_invoice', 'out_invoice')"><group><field name="erp_payment_retention" readonly="state != 'draft' or erp_retention_release_id"/><field name="erp_retention_method" readonly="state != 'draft'"/><field name="erp_retention_value" readonly="state != 'draft'"/><field name="erp_retention_amount"/><field name="erp_retention_release_id"/></group><field name="erp_retention_ids"/></page></xpath></field></record>
  <record id="view_register_retention" model="ir.ui.view"><field name="name">account.payment.register.retention</field><field name="model">account.payment.register</field><field name="inherit_id" ref="account.view_account_payment_register_form"/><field name="arch" type="xml"><xpath expr="//field[@name='journal_id']" position="after"><field name="erp_retention_amount"/><field name="erp_enforce_retention" invisible="not erp_retention_amount"/><field name="erp_apply_retention" invisible="not erp_retention_amount"/></xpath></field></record>
  <record id="view_company_retention" model="ir.ui.view"><field name="name">res.company.retention</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Payment Retention" groups="account.group_account_manager"><group><field name="erp_retention_payable_account_id"/><field name="erp_retention_receivable_account_id"/></group></page></xpath></field></record>
<record id="view_purchase_retention_terms" model="ir.ui.view"><field name="name">purchase.order.retention.terms</field><field name="model">purchase.order</field><field name="inherit_id" ref="erp_procurement.view_purchase_invoice_plan"/><field name="arch" type="xml"><xpath expr="//field[@name='erp_plan_interval_type']" position="after"><field name="erp_payment_retention"/><field name="erp_retention_value"/><field name="erp_retention_method"/></xpath><xpath expr="//field[@name='erp_invoice_plan_ids']/list/field[@name='installment']" position="after"><field name="invoice_type"/><field name="deposit_origin_id" optional="hide"/></xpath></field></record>
</odoo>
